---
import Footer from '../components/Footer.astro';
// Enterprise, 1:1 from design/Enterprise.dc.html (fidelity ruling
// 2026-08-20: the design is the spec). This page carries its OWN header
// and ends on the composite's dark band because the composite does; the
// composite's DCLogic defines data only, no animations. Two carve-outs
// stand (constitution): the pen-test row and the SOC 2 line keep the
// current not-yet wording inside the composite's exact row treatment,
// and region rows keep the composite's row/pill layout with honest
// status text (planned) instead of the invented "available".
import '../styles/fonts.css';
const title = 'Enterprise · KeepState';
const description = 'One system described for both buyers: engineering and audit. Deterministic replay, sequence lineage, region pinning, BYOK key isolation, and service levels written down.';
const canonical = new URL('/enterprise', Astro.site);

const platform = [
  'Any harness, any model. Your agent code does not change; the image does.',
  'Warm resume under 100 ms, cold under 90 s, on any provider.',
  'Cache-aware routing and stored-response replay, so an interrupted call is never bought twice.',
  'Org and per-session budgets with checkpoint-on-exceed. A cap parks work, it never kills it.',
  'Fleet view of parked agents, waking on schedule or on webhook.',
];

const compliance = [
  'Deterministic replay re-executes a run from checkpointed state, byte for byte.',
  'Sequence lineage on every event: what was called, in what order, with which checkpoint as parent.',
  'Retention policy editor measured in years, with legal hold that removes the delete path entirely.',
  'Audit bundle export as a signed archive, scoped to the sessions and range you name.',
  'SIEM webhook, SSO and SCIM, region pinning enforced at the scheduler.',
];

const sla = [
  { surface: 'API and control plane', uptime: '99.95%', credit: '10 to 30%', by: 'external probe, 1 min' },
  { surface: 'Gateway', uptime: '99.95%', credit: '10 to 30%', by: 'external probe, 1 min' },
  { surface: 'Checkpoint store, read', uptime: '99.99%', credit: '25 to 50%', by: 'external probe, 1 min' },
  { surface: 'Console', uptime: '99.9%', credit: 'none', by: 'external probe, 5 min' },
];

// Composite pill styles, verbatim: available/planned/sovereign. Carve-out:
// no region gate is green, so rows the composite marks "available" render
// the composite's layout with the honest status text and the composite's
// own planned treatment; Frankfurt keeps its sovereign treatment.
const pill = {
  planned: { dot: 'bg-sandDeep', cls: 'text-taupe bg-white border-sandDeep' },
  sovereign: { dot: 'bg-slate', cls: 'text-slate bg-parchment border-sand' },
};
const regions = [
  { code: 'us-east-1', city: 'Virginia', status: 'planned', s: pill.planned },
  { code: 'us-west-2', city: 'Oregon', status: 'planned', s: pill.planned },
  { code: 'eu-west-1', city: 'Dublin', status: 'planned', s: pill.planned },
  { code: 'eu-central-1', city: 'Frankfurt', status: 'planned, sovereign', s: pill.sovereign },
  { code: 'ap-northeast-1', city: 'Tokyo', status: 'planned', s: pill.planned },
  { code: 'ap-south-1', city: 'Mumbai', status: 'planned', s: pill.planned },
  { code: 'on-premises', city: 'your data center, enterprise only', status: 'planned', s: pill.planned },
];

// Pack rows verbatim from the composite; carve-out: the pen-test row keeps
// the current not-yet wording inside the composite's exact row treatment.
const pack = [
  { name: 'Data processing agreement', meta: 'PDF · v4.1' },
  { name: 'Subprocessor list', meta: 'PDF · updated monthly' },
  { name: 'Architecture overview', meta: 'PDF · 14 pages' },
  { name: 'Penetration test summary', meta: 'not yet commissioned' },
  { name: 'Claims file export', meta: 'CSV · live' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans min-h-screen antialiased leading-[normal]">

    <header class="sticky top-0 z-50 bg-paper/[0.94] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-4 flex items-center justify-between gap-6 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline hover:text-ink">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
          <span class="font-serif text-[21px] font-medium">KeepState</span>
        </a>
        <div class="flex items-center gap-[26px] flex-wrap">
          <a href="/" class="text-14 text-slate no-underline hover:text-ink">Product</a>
          <a href="/pricing" class="text-14 text-slate no-underline hover:text-ink">Pricing</a>
          <a href="/proof" class="text-14 text-slate no-underline hover:text-ink">Proof</a>
          <a href="/enterprise" class="text-14 text-ink font-medium no-underline hover:text-ink">Enterprise</a>
          <a href="#pack" class="text-14 font-medium text-paper bg-claret px-4 py-[9px] rounded-3 no-underline hover:no-underline hover:text-paper">Security review pack</a>
        </div>
      </nav>
    </header>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px] pb-12">
      <div class="flex items-center gap-[9px] mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Enterprise</span>
      </div>
      <h1 class="font-serif text-[clamp(40px,5.6vw,64px)] leading-[1.04] tracking-[-0.025em] font-normal m-0 mb-6 max-w-[15em]">Two buyers, one purchase.</h1>
      <p class="text-17 leading-[1.7] text-slate m-0 max-w-[44em] [text-wrap:pretty]">Durability is an engineering purchase and an audit purchase at the same time. Both columns below describe the same system, so nobody has to translate for the other.</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-5">
        <article class="bg-white border border-sand rounded-5 pt-[30px] px-7 pb-[30px]">
          <div class="flex items-center gap-[9px] mb-4">
            <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
            <span class="font-mono text-11 tracking-[0.1em] uppercase text-claret">Platform</span>
          </div>
          <p class="font-serif text-[24px] leading-[1.3] m-0 mb-5">Your engineers get durability and 40 to 60 percent lower token delivery cost.</p>
          <div class="grid gap-3.5">
            {platform.map((p) => (
              <div class="flex gap-[11px] items-start">
                <span class="w-[5px] h-[5px] bg-stone rotate-45 block mt-[7px] flex-none"></span>
                <p class="text-14 leading-[1.6] text-slate m-0">{p}</p>
              </div>
            ))}
          </div>
        </article>

        <article class="bg-slate border border-slate rounded-5 pt-[30px] px-7 pb-[30px]">
          <div class="flex items-center gap-[9px] mb-4">
            <span class="w-[7px] h-[7px] bg-blush rotate-45 block"></span>
            <span class="font-mono text-11 tracking-[0.1em] uppercase text-blush">Compliance</span>
          </div>
          <p class="font-serif text-[24px] leading-[1.3] text-paper m-0 mb-5">Your auditors get deterministic replay, sequence lineage, and retention measured in years.</p>
          <div class="grid gap-3.5">
            {compliance.map((c) => (
              <div class="flex gap-[11px] items-start">
                <span class="w-[5px] h-[5px] bg-blush rotate-45 block mt-[7px] flex-none"></span>
                <p class="text-14 leading-[1.6] text-slateSoft m-0">{c}</p>
              </div>
            ))}
          </div>
        </article>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-7">Service levels, written down.</h2>
      <div class="bg-white border border-sand rounded-5 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-13 min-w-[720px]">
            <thead>
              <tr class="bg-paper">
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-3 px-[18px] border-b border-sand">surface</th>
                <th class="text-right text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-3 px-[18px] border-b border-sand">availability</th>
                <th class="text-right text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-3 px-[18px] border-b border-sand">credit at breach</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-3 px-[18px] border-b border-sand">measured by</th>
              </tr>
            </thead>
            <tbody>
              {sla.map((r) => (
                <tr class="border-b border-track hover:bg-paper">
                  <td class="py-3.5 px-[18px] text-14 text-ink">{r.surface}</td>
                  <td class="py-3.5 px-[18px] font-mono text-claret text-right tabular-nums">{r.uptime}</td>
                  <td class="py-3.5 px-[18px] font-mono text-slate text-right tabular-nums">{r.credit}</td>
                  <td class="py-3.5 px-[18px] font-mono text-12 text-taupe">{r.by}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="text-13 text-taupe mt-3.5 mx-0.5 mb-0">Checkpoint durability is a data claim, not an uptime claim, and it is gated separately on the <a href="/proof" class="text-claret no-underline hover:text-ink hover:underline">Proof</a> page.</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px]">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-10 items-start">
        <div>
          <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3.5">Where your sessions can live.</h2>
          <p class="text-15 leading-[1.65] text-slate m-0 mb-[26px] max-w-[34em]">Region pinning is enforced at the scheduler, so a checkpoint cannot be written outside the region you pinned. Planned regions are labeled planned until a gate says otherwise.</p>
          <div class="grid gap-0 border-t border-sand">
            {regions.map((r) => (
              <div class="flex items-center justify-between gap-4 py-[13px] px-0.5 border-b border-track">
                <div class="flex items-center gap-[11px] min-w-0">
                  <span class={`w-[6px] h-[6px] ${r.s.dot} rotate-45 block flex-none`}></span>
                  <span class="font-mono text-13 text-ink">{r.code}</span>
                  <span class="text-13 text-taupe">{r.city}</span>
                </div>
                <span class={`font-mono text-10 tracking-[0.08em] border rounded-pill py-[3px] px-2.5 whitespace-nowrap ${r.s.cls}`}>{r.status}</span>
              </div>
            ))}
          </div>
        </div>

        <div id="pack" class="bg-white border border-sand rounded-5 pt-7 px-[26px] pb-7">
          <div class="flex items-center gap-[9px] mb-3.5">
            <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
            <span class="font-mono text-11 tracking-[0.1em] uppercase text-claret">Security review pack</span>
          </div>
          <p class="font-serif text-[24px] leading-[1.25] m-0 mb-3.5">Everything procurement asks for, in one download.</p>
          <p class="text-14 leading-[1.65] text-slate m-0 mb-5">No form, no call first. Read it, then decide whether to talk to us.</p>
          <div class="grid gap-2.5 mb-[22px]">
            {pack.map((p) => (
              <div class="flex items-center justify-between gap-3.5 border border-sand rounded-4 py-3 px-3.5">
                <div class="flex items-center gap-2.5 min-w-0">
                  <span class="w-[5px] h-[5px] bg-stone rotate-45 block flex-none"></span>
                  <span class="text-13 text-ink">{p.name}</span>
                </div>
                <span class="font-mono text-11 text-taupe whitespace-nowrap">{p.meta}</span>
              </div>
            ))}
          </div>
          <a href="#pack" class="block text-15 font-medium text-paper bg-claret rounded-3 py-[13px] px-[18px] text-center no-underline hover:no-underline hover:text-paper">Download the pack</a>
          <p class="font-mono text-11 text-taupe mt-3.5 mb-0 text-center">SOC 2 Type II · not yet claimed · this line gets a date only when an audit window opens</p>
        </div>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3.5">The real key never enters a guest, an image, or a snapshot.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-[30px] max-w-[44em]">Your provider keys live in a vault outside the isolation boundary. The gateway mints a virtual key scoped to one session, and that is the only credential a VM ever sees. A checkpoint of that VM therefore contains no secret worth stealing.</p>
      <div class="bg-white border border-sand rounded-5 pt-[30px] px-[26px] pb-[30px]">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,200px),1fr))] gap-4 items-stretch">
          <div class="bg-blushBg border border-shell rounded-4 p-5 text-center">
            <p class="font-mono text-12 text-claret m-0 mb-2">BYOK vault</p>
            <p class="text-12 leading-[1.55] text-slate m-0">your real provider key, encrypted, outside the boundary</p>
          </div>
          <div class="bg-white border border-sand rounded-4 p-5 text-center">
            <p class="font-mono text-12 text-ink m-0 mb-2">gateway</p>
            <p class="text-12 leading-[1.55] text-slate m-0">mints a virtual key scoped to one session, meters, enforces exactly-once</p>
          </div>
          <div class="bg-ink rounded-4 p-5 text-center">
            <p class="font-mono text-12 text-blush m-0 mb-2">micro-VM</p>
            <p class="text-12 leading-[1.55] text-borderMuted m-0">the agent, its filesystem, its tools. Sees the virtual key only</p>
          </div>
          <div class="bg-parchment border border-sand rounded-4 p-5 text-center">
            <p class="font-mono text-12 text-slate m-0 mb-2">checkpoint store</p>
            <p class="text-12 leading-[1.55] text-slate m-0">encrypted at rest, region-pinned, no live credential inside</p>
          </div>
        </div>
      </div>
    </section>

    <section class="bg-ink mt-[76px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[76px]">
        <div class="max-w-[44em]">
          <h2 class="font-serif text-[clamp(30px,4.2vw,46px)] leading-[1.1] tracking-[-0.02em] font-normal text-paper m-0 mb-[22px]">Our own build is governed by the same audit discipline we sell.</h2>
          <p class="text-17 leading-[1.7] text-borderMuted m-0 mb-[30px]">Gates before evidence, evidence before claims, <span class="text-blush">no claim without a tag</span>. The constitution that produces the ledger you are buying is public.</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="#pack" class="text-15 font-medium text-paper bg-claret px-[22px] py-[13px] rounded-3 no-underline hover:no-underline hover:text-paper">Talk to us</a>
            <a href="/proof" class="text-15 font-medium text-paper border border-inkLine px-[21px] py-3 rounded-3 no-underline hover:no-underline hover:text-paper">Read the constitution</a>
          </div>
          <p class="font-mono text-11 tracking-[0.1em] text-termMuted mt-[30px] mb-0">keepstate.ai · the durable agent session cloud</p>
        </div>
      </div>
    </section>
    <Footer variant="marketing" />
  </body>
</html>
