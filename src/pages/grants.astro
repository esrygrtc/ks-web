---
// Grants: the program page + application form UI, from design/Grants.dc.html.
// Prose, tracks (offers), asks, and steps carried verbatim (dedashed).
// The composite's sample metrics (31 grants, $186,000, 9-day median,
// "measured on the last 14 releases", gate G-171) and its invented award
// recipients are illustrations, not facts in src/generated/proof.json;
// they render here as honest not-yet states per UI Laws 1-3. The form
// posts to /api/grants (backend arrives at W4); success/error states are
// omitted rather than faked.
import Site from '../layouts/Site.astro';
import Field from '../components/Field.astro';

const tracks = [
  {
    tag: 'track 1', title: 'Open-source harness maintainers',
    body: 'You wrote the agent people actually use. We wrap it, gate it, and keep the wrap current at your release cadence rather than ours.',
    gets: [
      'Session credits for your own development and CI',
      'Engineering time from us on the wrap, not a support queue',
      'A compatibility row of your own, gated and published',
      'Day-0 wrapping of new releases within 48 hours',
    ],
    award: '$5,000 to $25,000', term: '12 months, renewable · no exclusivity',
    card: 'bg-blushBg border-shell', dot: 'bg-claret', eyebrow: 'text-claret',
    bodyC: 'text-slate', rule: 'border-shell', metaC: 'text-taupe', figC: 'text-claret',
  },
  {
    tag: 'track 2', title: 'Researchers',
    body: 'Long-horizon agent studies need sessions that outlive the machine. A trial that dies at hour 40 is not a result, it is a lost week.',
    gets: [
      'Credits sized to a study, not a month',
      'Sessions that survive cluster preemption',
      'Deterministic replay for reproducible trials',
      'Retention long enough to outlast peer review',
    ],
    award: '$2,500 to $15,000', term: 'per study · extended on request',
    card: 'bg-white border-sand', dot: 'bg-stone', eyebrow: 'text-taupe',
    bodyC: 'text-slate', rule: 'border-track', metaC: 'text-taupe', figC: 'text-ink',
  },
  {
    tag: 'track 3', title: 'Students',
    body: 'No institutional affiliation required and no proposal review board. If you are learning to build agents, the meter should not be the thing that stops you.',
    gets: [
      'Credits that do not expire mid-term',
      'The same durability the paid tiers get',
      'No card on file, ever',
      'A published project counts as the report',
    ],
    award: '$500 to $2,000', term: 'one academic year · renewable once',
    card: 'bg-white border-sand', dot: 'bg-stone', eyebrow: 'text-taupe',
    bodyC: 'text-slate', rule: 'border-track', metaC: 'text-taupe', figC: 'text-ink',
  },
];

const asks = [
  'Tell us when the freeze does not hold for your harness. A failed absorption is a finding we publish, and it is worth more to us than a testimonial.',
  'Let us gate your project publicly, including the rows where the answer is only observed rather than proven.',
  'Keep building whatever you were going to build. If that turns out to be something we compete with, the credits still stand for the term.',
];

const steps = [
  { n: '01', text: 'Pick a track and tell us who you are. A GitHub handle is enough identification.' },
  { n: '02', text: 'Link the project. Anything public: a repo, a paper, a demo, a thread.' },
  { n: '03', text: 'Describe the workload and, more usefully, what breaks about it today.' },
  { n: '04', text: 'Name a number. Asking for more than the range does not disqualify you, it just needs a sentence.' },
];

const trackPicks = ['Maintainer', 'Researcher', 'Student'];
---
<Site title="Grants · KeepState" description="KeepState Grants: session credits, engineering time, and a gated compatibility row for open-source harness maintainers, researchers, and students. Apply in four questions.">
  <main class="max-w-[1180px] mx-auto px-7">

    <section class="pt-14 pb-11">
      <div class="flex items-center gap-2 mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Grants</span>
      </div>
      <h1 class="font-serif text-34 font-normal leading-[1.08] tracking-[-0.02em] mt-0 mb-6 max-w-[17em]">KeepState Grants: compute for the people building the agents.</h1>
      <p class="text-17 leading-relaxed text-slate mt-0 mb-5 max-w-[44em]">The harnesses we wrap were written by people who were not paid to make our product work. Grants are how we settle that: session credits, engineering time, and a compatibility row of your own so your users can see the freeze holds.</p>
      <p class="font-mono text-12 text-taupe m-0">the program opens with this site · awards, totals, and decision times publish here as they are made, not before</p>
    </section>

    <section>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4 items-stretch">
        {tracks.map((t) => (
          <article class={`border rounded-5 p-6 flex flex-col gap-4 ${t.card}`}>
            <div>
              <div class="flex items-center gap-2 mb-3.5">
                <span class={`w-[7px] h-[7px] rotate-45 block ${t.dot}`}></span>
                <span class={`font-mono text-11 tracking-[0.1em] uppercase ${t.eyebrow}`}>{t.tag}</span>
              </div>
              <p class="font-serif text-22 leading-tight text-ink mt-0 mb-3">{t.title}</p>
              <p class={`text-14 leading-relaxed m-0 ${t.bodyC}`}>{t.body}</p>
            </div>
            <div class="grid gap-2 flex-1 content-start">
              {t.gets.map((g) => (
                <div class="flex gap-2.5 items-start">
                  <span class={`w-[5px] h-[5px] rotate-45 block mt-1.5 shrink-0 ${t.dot}`}></span>
                  <p class={`text-13 leading-normal m-0 ${t.bodyC}`}>{g}</p>
                </div>
              ))}
            </div>
            <div class={`border-t pt-4 ${t.rule}`}>
              <div class="flex items-baseline justify-between gap-3 mb-1.5">
                <span class={`font-mono text-11 ${t.metaC}`}>typical award</span>
                <span class={`font-mono text-14 ${t.figC}`}>{t.award}</span>
              </div>
              <p class={`font-mono text-11 leading-normal m-0 ${t.metaC}`}>{t.term}</p>
            </div>
          </article>
        ))}
      </div>
    </section>
  </main>

  <section class="bg-parchment border-y border-sand mt-14">
    <div class="max-w-[1180px] mx-auto px-7 py-10 flex items-center gap-6 flex-wrap justify-between">
      <div class="flex items-center gap-3.5 min-w-0">
        <span class="w-2.5 h-2.5 bg-claret rotate-45 block shrink-0"></span>
        <p class="font-serif text-22 leading-snug m-0">Day-0 support is a promise: new harness releases get a wrapped image within 48 hours.</p>
      </div>
      <p class="font-mono text-11 leading-relaxed text-taupe m-0 max-w-[24em]">not yet measured on a public release · the gate and its numbers publish to <a href="/proof" class="text-claret no-underline hover:underline">/proof</a> with the first day-0 wrap</p>
    </div>
  </section>

  <main class="max-w-[1180px] mx-auto px-7">
    <section class="pt-14">
      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <div>
          <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-4">What we ask in return.</h2>
          <p class="text-15 leading-relaxed text-slate mt-0 mb-5">Not a logo, not a case study, not an exclusivity clause. Three things, all of which we would want anyway:</p>
          <div class="border-t border-sand">
            {asks.map((a) => (
              <div class="flex gap-3 items-start py-4 px-0.5 border-b border-sand">
                <span class="w-[6px] h-[6px] bg-claret rotate-45 block mt-[7px] shrink-0"></span>
                <p class="text-14 leading-relaxed text-slate m-0">{a}</p>
              </div>
            ))}
          </div>
          <p class="text-13 leading-relaxed text-taupe mt-5 mb-0">Grants are not a sales channel. Building something that competes with us does not end the term.</p>
        </div>

        <div>
          <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-4">Recent awards.</h2>
          <p class="text-15 leading-relaxed text-slate mt-0 mb-5">Names appear only where the grantee asked for them. The rest are described by what they build.</p>
          <div class="border border-dashed border-sandDeep rounded-5 p-5">
            <p class="text-14 font-medium text-ink mt-0 mb-1.5">No awards published yet.</p>
            <p class="text-13 leading-relaxed text-slate m-0">The program opens with this site. The first grants land in this table when they are made, with the track, what the grantee builds, and the amount; a name only with their consent.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="apply" class="pt-16 pb-8">
      <div class="grid lg:grid-cols-2 gap-8 items-start">
        <div>
          <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-4">Apply.</h2>
          <p class="text-15 leading-relaxed text-slate mt-0 mb-6">Four questions. A human reads it, and you get a yes or a no with a reason, never silence.</p>
          <div class="grid gap-0">
            {steps.map((st) => (
              <div class="flex gap-3 items-start py-3 border-t border-sand">
                <span class="font-mono text-11 text-claret w-[18px] shrink-0 mt-1">{st.n}</span>
                <p class="text-14 leading-relaxed text-slate m-0">{st.text}</p>
              </div>
            ))}
          </div>
        </div>

        <form method="post" action="/api/grants" class="bg-white border border-sand rounded-5 p-6">
          <input type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="display:none" />

          <fieldset class="border-0 p-0 m-0 mb-5">
            <legend class="text-12 font-medium text-slate p-0 mb-2.5">Which track</legend>
            <div class="flex gap-2 flex-wrap">
              {trackPicks.map((label, i) => (
                <label class="cursor-pointer">
                  <input type="radio" name="track" value={label} checked={i === 0} class="peer sr-only" />
                  <span class="inline-flex items-center font-sans text-13 font-medium text-slate bg-white border border-sand rounded-3 px-3.5 min-h-[38px] select-none peer-checked:bg-ink peer-checked:text-paper peer-checked:border-ink peer-focus-visible:outline peer-focus-visible:outline-2 peer-focus-visible:outline-claret">{label}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="grid gap-4 mb-5">
            <Field label="Name" name="name" placeholder="Your name" />
            <Field label="Project link" name="link" mono placeholder="github.com/you/your-harness" />
            <label class="block">
              <span class="block text-12 font-medium text-slate mb-1.5">What will you run</span>
              <textarea name="run" rows="4" placeholder="The workload, roughly how long a single run takes, and what breaks today"
                class="w-full font-sans text-14 leading-relaxed text-ink bg-white border border-sand rounded-3 px-3 py-2.5 resize-y focus:outline-none focus:border-ink"></textarea>
            </label>
            <div>
              <div class="flex items-baseline justify-between gap-3 mb-2">
                <label for="gr-credits" class="text-12 font-medium text-slate">Credits requested</label>
                <span id="gr-credits-out" class="font-mono text-14 text-claret tabular-nums">$5,000</span>
              </div>
              <input id="gr-credits" name="credits" type="range" min="500" max="25000" step="500" value="5000" class="w-full accent-claret" />
              <p id="gr-credits-note" class="font-mono text-11 text-taupe mt-2.5 mb-0">maintainer range is $5,000 to $25,000</p>
            </div>
          </div>

          <button type="submit" class="w-full font-sans text-15 font-medium text-paper bg-claret border border-claret rounded-3 px-[18px] py-3 cursor-pointer hover:bg-claretDeep">Send the application</button>
          <p class="text-12 leading-relaxed text-taupe mt-3.5 mb-0">No pitch deck, no call required. If we need more we will ask one question by email.</p>
        </form>
      </div>
    </section>
  </main>

  <script>
    // Form UI only: mirrors the range value and the per-track range note.
    // No submission is simulated; the backend arrives at W4.
    const notes: Record<string, string> = {
      Maintainer: 'maintainer range is $5,000 to $25,000',
      Researcher: 'researcher range is $2,500 to $15,000',
      Student: 'student range is $500 to $2,000',
    };
    const range = document.getElementById('gr-credits') as HTMLInputElement | null;
    const out = document.getElementById('gr-credits-out');
    const note = document.getElementById('gr-credits-note');
    range?.addEventListener('input', () => {
      if (out && range) out.textContent = '$' + Number(range.value).toLocaleString('en-US');
    });
    document.querySelectorAll<HTMLInputElement>('input[name="track"]').forEach((el) => {
      el.addEventListener('change', () => {
        if (note && notes[el.value]) note.textContent = notes[el.value];
      });
    });
  </script>
</Site>
