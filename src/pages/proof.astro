---
import Footer from '../components/Footer.astro';
// Proof, 1:1 from design/Proof.dc.html. The page carries its OWN header
// because the composite does (and no footer, because the composite has
// none); every section, size, and color below mirrors the composite's
// inline styles, and the filter-pill interaction mirrors its DCLogic.
//
// UI Law 4 survives the fidelity ruling: every claim row, status pill,
// tag, matrix cell, and archive card below renders from
// src/generated/proof.json (synced by scripts/sync-claims). Nothing in
// a row is typed by hand; CI fails if the JSON disagrees with a fresh
// generation. The composite's placeholder claims (G-101, "118 / 121",
// F-061...) are exactly that: placeholders its shell now renders real
// data into.
import '../styles/fonts.css';
import proof from '../generated/proof.json';
const title = 'Proof · KeepState';
const description = 'Every public claim KeepState makes, and the green gate that proves it. Generated from the product repository; never typed.';
const canonical = new URL('/proof', Astro.site);

const tagRe = /(gate-[0-9a-z]+-green|v\d+\.\d+\.\d+[\w.-]*)/g;
const gateTags = proof.tags.filter((t) => t.tag.startsWith('gate-'));
const releases = proof.tags.filter((t) => !t.tag.startsWith('gate-'));
// Markdown carried by the claims file: bold survives as <strong>,
// backticks flatten (every cell that carries them is already mono).
const bold = (s: string) => s.replace(/`([^`]+)`/g, '$1').replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>').replace(/\*([^*]+)\*/g, '<em>$1</em>');
const plain = (s: string) => s.replace(/`([^`]+)`/g, '$1').replace(/\*\*([^*]+)\*\*/g, '$1').replace(/\*([^*]+)\*/g, '$1');
const anchor = (tag: string) => tag.replace('-green', '');

// The claims table: proven rows carry their gate tags; the deliberately
// not-claimed sentences are rows too, with no tag to cite - the design's
// "no gate yet" treatment renders that absence instead of hiding it.
const rows = [
  ...proof.proven.map((r) => ({
    claim: r.claim,
    evidence: r.evidence,
    status: 'Proven',
    tags: [...r.provenBy.matchAll(tagRe)].map((m) => m[1]),
  })),
  ...proof.antiClaims.map((a) => ({
    claim: a.head,
    evidence: a.body,
    status: 'Not claimed',
    tags: [] as string[],
  })),
];
const statuses = [...new Set(rows.map((r) => r.status))];

// Status pill treatments, verbatim from the composite's DCLogic style().
const pills: Record<string, { chip: string; dot: string }> = {
  Proven: { chip: 'text-claret bg-blushBg border-shell', dot: 'bg-claret' },
  Observed: { chip: 'text-slate bg-white border-slate', dot: 'bg-slate' },
  'Not claimed': { chip: 'text-taupe bg-white border-sandDeep', dot: 'bg-sandDeep' },
};

// The absorption matrix: verdict = the bold lead of the synced row;
// whatever follows it (door held 4 of 4, ...) is the measured detail.
const matrix = proof.matrix.map((m) => {
  const v = m.verdict.match(/^\*\*(.+?)\*\*\s*(?:·\s*)?([\s\S]*)$/);
  const verdict = v ? v[1] : plain(m.verdict);
  const detail = plain(v ? v[2] : '');
  const tags = [...m.evidence.matchAll(tagRe)].map((x) => x[1]);
  const rest = plain(m.evidence).replace(tagRe, '').replace(/\s+/g, ' ').trim();
  return { agent: m.agent, verdict, detail, tags, rest, pill: verdict === 'claimed' ? pills.Proven : pills.Observed };
});

// The archive cards: one per tag in the repository, subject de-duplicated
// from its tag prefix. Card ids keep the site's /proof#gate-N deep links.
const cards = proof.tags.map((t) => {
  const m = t.subject.match(/^gate-[0-9a-z]+ green:?\s*([\s\S]*)$/);
  const title = (m && m[1]) || t.subject.replace(/^KeepState v[\d.][\w.-]*\s*·\s*/, '');
  return { tag: t.tag, id: anchor(t.tag), title };
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans min-h-screen antialiased">

    <header class="sticky top-0 z-50 bg-paper/[0.94] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-4 flex items-center justify-between gap-6 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline hover:text-ink">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
          <span class="font-serif text-[21px] font-medium">KeepState</span>
        </a>
        <div class="flex items-center gap-[26px] flex-wrap">
          <a href="/" class="text-14 text-slate no-underline hover:text-ink">Product</a>
          <a href="/pricing" class="text-14 text-slate no-underline hover:text-ink">Pricing</a>
          <a href="/proof" class="text-14 text-ink font-medium no-underline hover:text-ink">Proof</a>
          <a href="/enterprise" class="text-14 text-slate no-underline hover:text-ink">Enterprise</a>
          <a href="/manifesto" class="text-14 text-slate no-underline hover:text-ink">Manifesto</a>
          <a href="/#partner" class="text-14 font-medium text-paper bg-claret px-4 py-[9px] rounded-3 no-underline hover:no-underline hover:text-paper">Start building</a>
        </div>
      </nav>
    </header>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px] pb-11">
      <div class="flex items-center gap-[9px] mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Proof</span>
      </div>
      <h1 class="font-serif text-[clamp(40px,5.6vw,64px)] leading-[1.04] tracking-[-0.025em] font-normal m-0 mb-6 max-w-[14em]">No claim outlives its evidence.</h1>
      <p class="text-17 leading-[1.7] text-slate m-0 mb-[26px] max-w-[44em] [text-wrap:pretty]">This page renders our claims file. Every row cites the gate run that proves it; unproven claims cannot appear here, by construction.</p>
      <div class="flex gap-[22px] flex-wrap font-mono text-12 text-taupe">
        <span>claims file: <span class="text-ink">{proof.syncedFrom.repo}/{proof.syncedFrom.file} @ {proof.sourceSha.slice(0, 12)}</span></span>
        <span>gates green: <span class="text-ink">{gateTags.length}</span></span>
        <span>releases: <span class="text-ink">{releases.map((r) => r.tag).join(' · ')}</span></span>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7" id="claims">
      <div class="flex items-center gap-2.5 flex-wrap mb-4">
        <button type="button" data-filter="all" class="font-mono text-11 tracking-[0.08em] bg-ink text-paper border border-ink rounded-pill px-[13px] py-1.5 cursor-pointer">all claims</button>
        {statuses.map((s) => (
          <button type="button" data-filter={s} class="font-mono text-11 tracking-[0.08em] bg-white text-slate border border-sand rounded-pill px-[13px] py-1.5 cursor-pointer">{s.toLowerCase()}</button>
        ))}
      </div>

      <div class="bg-white border border-sand rounded-5 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-13 min-w-[880px]">
            <thead>
              <tr class="bg-paper">
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand w-[40%]">claim</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">the evidence</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">status</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">proven by</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((r, i) => (
                <tr class="border-b border-track align-top hover:bg-paper" data-status={r.status} id={r.status === 'Not claimed' && i === proof.proven.length ? 'not-claimed' : undefined}>
                  <td class="px-[18px] py-[15px]">
                    <p class="text-14 leading-[1.55] text-ink m-0" set:html={bold(r.claim)} />
                  </td>
                  <td class="px-[18px] py-[15px]">
                    <p class="font-mono text-11 leading-[1.55] text-taupe m-0">{plain(r.evidence)}</p>
                  </td>
                  <td class="px-[18px] py-[15px] whitespace-nowrap">
                    <span class={`inline-flex items-center gap-[7px] font-mono text-10 tracking-[0.08em] border rounded-pill px-2.5 py-1 ${pills[r.status].chip}`}>
                      <span class={`w-[5px] h-[5px] rotate-45 block ${pills[r.status].dot}`}></span>{r.status}
                    </span>
                  </td>
                  <td class="px-[18px] py-[15px] whitespace-nowrap">
                    {r.tags.length > 0
                      ? r.tags.map((t, j) => (
                          <a href={`#${anchor(t)}`} class={`flex items-center gap-[7px] font-mono text-12 text-claret no-underline hover:text-ink hover:underline underline-offset-[3px] ${j > 0 ? 'mt-1.5' : ''}`}>
                            <span class="w-[5px] h-[5px] bg-claret rotate-45 inline-block"></span>{t}
                          </a>
                        ))
                      : <span class="font-mono text-12 text-stone">no gate yet</span>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="text-13 leading-[1.65] text-taupe mt-4 mb-0 mx-0.5 max-w-[46em]">A claim whose gate goes red is removed from this page automatically, not softened by hand. That is why the count above can go down.</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3">When behavior splits by third party, the claim splits with it.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-7 max-w-[42em]">Absorption means the harness never notices the freeze. Where it holds for one agent and not another, we publish both rows rather than one average.</p>
      <div class="bg-white border border-sand rounded-5 overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full border-collapse text-13 min-w-[640px]">
            <thead>
              <tr class="bg-paper">
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">agent</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">absorption claim</th>
                <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-[18px] py-3 border-b border-sand">evidence</th>
              </tr>
            </thead>
            <tbody>
              {matrix.map((m) => (
                <tr class="border-b border-track align-top hover:bg-paper">
                  <td class="px-[18px] py-3.5 font-mono text-ink whitespace-nowrap">{m.agent}</td>
                  <td class="px-[18px] py-3.5">
                    <span class={`inline-flex items-center gap-[7px] font-mono text-10 tracking-[0.08em] border rounded-pill px-2.5 py-1 whitespace-nowrap ${m.pill.chip}`}>
                      <span class={`w-[5px] h-[5px] rotate-45 block ${m.pill.dot}`}></span>{m.verdict}
                    </span>
                    {m.detail && <p class="font-mono text-10 text-taupe mt-1.5 mb-0">{m.detail}</p>}
                  </td>
                  <td class="px-[18px] py-3.5">
                    {m.tags.length > 0
                      ? m.tags.map((t, j) => (
                          <a href={`#${anchor(t)}`} class={`block font-mono text-12 text-claret no-underline hover:text-ink hover:underline underline-offset-[3px] w-fit ${j > 0 ? 'mt-1.5' : ''}`}>{t}</a>
                        ))
                      : <span class="font-mono text-12 text-stone">no gate yet</span>}
                    {m.rest && <p class="font-mono text-10 text-taupe mt-1.5 mb-0">{m.rest}</p>}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
      <p class="text-13 leading-[1.65] text-taupe mt-4 mb-0 mx-0.5 max-w-[46em]">The per-agent picture lives on <a href="/compatibility" class="text-claret no-underline hover:text-ink hover:underline underline-offset-[3px]">Compatibility</a>.</p>
    </section>

    <section id="archive" class="bg-slate mt-[76px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[68px]">
        <div class="flex items-center gap-[9px] mb-5">
          <span class="w-[7px] h-[7px] bg-blush rotate-45 block"></span>
          <span class="text-11 font-semibold tracking-[0.16em] uppercase text-blush">Findings archive</span>
        </div>
        <h2 class="font-serif text-[clamp(28px,3.8vw,42px)] leading-[1.1] tracking-[-0.02em] font-normal text-paper m-0 mb-5 max-w-[24em]">We publish our own defects.</h2>
        <p class="text-16 leading-[1.7] text-slateSoft m-0 mb-[34px] max-w-[42em]">{proof.closing}</p>
        <div class="grid gap-3 max-w-[52em]">
          {cards.map((t) => (
            <div id={t.id} class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,180px),1fr))] gap-x-5 gap-y-2 bg-paper/[0.05] border border-slateLine rounded-4 px-5 py-[18px] items-baseline scroll-mt-24">
              <div>
                <p class="font-mono text-11 text-blush m-0 mb-1.5">{t.tag}</p>
                <p class="text-15 font-medium text-paper m-0">{t.title}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-[72px] pb-[88px]">
      <div class="max-w-[46em]">
        <p class="font-serif italic text-[clamp(22px,3vw,30px)] leading-[1.4] text-ink m-0 mb-[26px]">What gates watch stays true. What nothing watches drifts.</p>
        <p class="text-16 leading-[1.7] text-slate m-0 mb-[26px]">If a number on this site is wrong, that is a finding, and we would rather have it than not. Send it with the trace and we will publish the correction with your name on it unless you ask us not to.</p>
        <div class="flex gap-3.5 flex-wrap">
          <a href="/contact" class="text-15 font-medium text-paper bg-claret px-[22px] py-[13px] rounded-3 no-underline hover:no-underline hover:text-paper">Report a finding</a>
          <a href="/pricing" class="text-15 font-medium text-ink border border-sand px-[21px] py-3 rounded-3 no-underline hover:no-underline hover:text-ink">See pricing</a>
        </div>
      </div>
    </section>

    <style>
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>

    <script is:inline>
      // The composite's DCLogic filter interaction, vanilla: the active
      // pill goes ink-on-paper and rows outside the filter hide.
      (() => {
        const on = ['bg-ink', 'text-paper', 'border-ink'];
        const off = ['bg-white', 'text-slate', 'border-sand'];
        const btns = Array.from(document.querySelectorAll('[data-filter]'));
        const rows = Array.from(document.querySelectorAll('tr[data-status]'));
        btns.forEach((b) => b.addEventListener('click', () => {
          btns.forEach((x) => { x.classList.remove(...on); x.classList.add(...off); });
          b.classList.remove(...off);
          b.classList.add(...on);
          rows.forEach((r) => { r.style.display = b.dataset.filter === 'all' || r.dataset.status === b.dataset.filter ? '' : 'none'; });
        }));
      })();
    </script>
    <Footer variant="marketing" />
  </body>
</html>
