---
// Shared shell for the four product pages (underscore = not routed).
// Tab switcher, hero, metrics with provenance, evidence line, dark CTA.
// The per-product explainer section arrives through the slot.
// UI Law 2: every metric goes through MetricCard, which enforces a
// MEASURED/ESTIMATED badge or an evidence link at build time.
import Site from '../../layouts/Site.astro';
import MetricCard from '../../components/MetricCard.astro';

interface Metric {
  label: string;
  value: string | null;
  note?: string;
  badge?: 'MEASURED' | 'ESTIMATED';
  evidenceHref?: string;
  evidenceTag?: string;
  reason?: string;
}
interface GateLink { tag: string; href: string }
interface Props {
  slug: 'sessions' | 'fork' | 'gateway-cost' | 'governance-replay';
  title: string;
  description: string;
  eyebrow: string;
  headline: string;
  standfirst: string;
  metrics: Metric[];
  evidenceLine: string;
  gates: GateLink[];
  ctaHead: string;
  ctaBody: string;
}
const { slug, title, description, eyebrow, headline, standfirst, metrics, evidenceLine, gates, ctaHead, ctaBody } = Astro.props;
const products = [
  { slug: 'sessions', label: 'Sessions' },
  { slug: 'fork', label: 'Fork' },
  { slug: 'gateway-cost', label: 'Gateway & Cost' },
  { slug: 'governance-replay', label: 'Governance & Replay' },
];
---
<Site title={title} description={description}>
  <main>
    <nav aria-label="Product pages" class="border-b border-sand">
      <div class="max-w-[1180px] mx-auto px-7 py-3 flex gap-1 flex-wrap">
        {products.map((p) => (
          <a
            href={`/product/${p.slug}`}
            aria-current={p.slug === slug ? 'page' : undefined}
            class={`text-13 font-medium border rounded-3 px-3.5 py-2 no-underline whitespace-nowrap hover:no-underline ${
              p.slug === slug
                ? 'bg-ink text-paper border-ink hover:text-paper'
                : 'text-slate border-sand hover:text-ink hover:border-ink'
            }`}
          >{p.label}</a>
        ))}
      </div>
    </nav>

    <section class="max-w-[1180px] mx-auto px-7 pt-16">
      <div class="flex items-center gap-2 mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">{eyebrow}</span>
      </div>
      <h1 class="font-serif text-34 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-6 max-w-[18em]">{headline}</h1>
      <p class="text-17 leading-[1.7] text-slate mt-0 mb-10 max-w-[44em]">{standfirst}</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7">
      <slot />
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-14" id="evidence">
      <div class="grid gap-[18px] grid-cols-[repeat(auto-fit,minmax(min(100%,240px),1fr))]">
        {metrics.map((m) => (
          <MetricCard
            label={m.label}
            value={m.value}
            note={m.note}
            badge={m.badge}
            evidenceHref={m.evidenceHref}
            evidenceTag={m.evidenceTag}
            reason={m.reason}
          />
        ))}
      </div>
      <p class="text-14 leading-[1.7] text-slate mt-6 mb-0 max-w-[46em]">
        {evidenceLine}
        {gates.map((g) => (
          <a href={g.href} class="inline-flex items-center gap-1.5 font-mono text-12 text-claret no-underline hover:underline ml-2">
            <span class="w-[5px] h-[5px] bg-claret rotate-45 inline-block"></span>{g.tag}
          </a>
        ))}
      </p>
    </section>

    <section id="cta" class="bg-ink mt-[76px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[72px]">
        <div class="max-w-[44em]">
          <h2 class="font-serif text-26 leading-[1.15] tracking-[-0.02em] font-normal text-paper mt-0 mb-5">{ctaHead}</h2>
          <p class="text-17 leading-[1.7] text-borderMuted mt-0 mb-8">{ctaBody}</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="/#partner" class="text-15 font-medium text-paper bg-claret rounded-3 px-[22px] py-3 no-underline hover:bg-claretDeep hover:text-paper hover:no-underline">Start building</a>
            <a href="/proof" class="text-15 font-medium text-paper border border-inkSoft rounded-3 px-[21px] py-3 no-underline hover:border-termMuted hover:text-paper hover:no-underline">See the proof</a>
          </div>
          <p class="font-mono text-11 tracking-[0.1em] text-termMuted mt-8 mb-0">keepstate.ai · the durable agent session cloud</p>
        </div>
      </div>
    </section>
  </main>
</Site>
