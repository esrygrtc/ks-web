---
import Footer from '../components/Footer.astro';
// Security, 1:1 from design/Security.dc.html (fidelity ruling 2026-08-20:
// the design is the spec). This page carries its OWN header and ends on
// the composite's dark band because the composite does; the composite's
// DCLogic defines data only, no animations. One carve-out stands
// (constitution): certification rows that assert unverifiable records
// (SOC 2 audit window, pen-test completion date) keep the current
// not-yet wording inside the composite's exact pill treatment.
// Non-token hexes in the composite, rendered with the nearest token:
import '../styles/fonts.css';
const title = 'Security · KeepState';
const description = 'The KeepState isolation boundary: the real key never enters a guest, an image, or a snapshot. Key handling stated as rules, encryption surfaces, certifications stated honestly, and responsible disclosure.';
const canonical = new URL('/security', Astro.site);

const boundary = [
  {
    name: 'BYOK vault',
    body: 'Your real provider key, encrypted per organization, outside the isolation boundary and unreachable from any guest.',
    meta: 'AES-256-GCM · HSM-backed root · no read path from the data plane',
    card: 'bg-blushBg border-shell', dot: 'bg-claret', titleC: 'text-claret', bodyC: 'text-slate',
    metaC: 'text-termMuted',
  },
  {
    name: 'Gateway',
    body: 'Mints a virtual key scoped to one session, meters every call, and enforces exactly-once billing on our side of the wire.',
    meta: 'virtual keys expire at session end · never handled by a human',
    card: 'bg-white border-sand', dot: 'bg-slate', titleC: 'text-ink', bodyC: 'text-slate', metaC: 'text-taupe',
  },
  {
    name: 'Micro-VM guest',
    body: 'The agent, its filesystem, its tools. Hardware-virtualized, one tenant, no shared kernel. Sees the virtual key only.',
    meta: 'egress allowlisted to the gateway · no inbound path',
    card: 'bg-ink border-ink', dot: 'bg-blush', titleC: 'text-blush', bodyC: 'text-borderMuted', metaC: 'text-termMuted',
  },
  {
    name: 'Checkpoint store',
    body: 'Content-addressed, encrypted at rest, pinned to the region you named. Contains no live credential by construction.',
    meta: 'per-org keys · region enforced at the scheduler',
    card: 'bg-parchment border-sand', dot: 'bg-stone', titleC: 'text-ink', bodyC: 'text-slate', metaC: 'text-taupe',
  },
];

const rules = [
  { rule: 'A provider key is never written into a guest.',
    detail: 'The vault has no read path from the data plane. A guest that asks for a key gets a virtual key, or nothing.',
    gate: 'G-151' },
  { rule: 'A checkpoint is scanned for credential material before it is acknowledged.',
    detail: 'If a secret pattern appears in a snapshot, the checkpoint is quarantined and the session is halted rather than silently stored.',
    gate: 'G-153' },
  { rule: 'Virtual keys are scoped to one session and die with it.',
    detail: 'Scope covers the session id, the model set you authorized, and the budget remaining. A leaked virtual key buys nothing after the session ends.',
    gate: 'G-152' },
  { rule: 'Humans never handle a virtual key.',
    detail: 'They are minted, injected, and revoked by the gateway. No console screen displays one, and no support process asks for one.',
    gate: 'G-152' },
  { rule: 'A revoked key stops working mid-session.',
    detail: 'Revocation is immediate at the gateway, not on next issue. The session checkpoints and parks rather than continuing on a credential you withdrew.',
    gate: 'G-154' },
  { rule: 'Support staff cannot read your checkpoints.',
    detail: 'Access requires a break-glass path that notifies your Owners, writes to your audit log, and expires in one hour. Enterprise customers holding their own root key can make it impossible outright.',
    gate: '' },
];

const crypto = [
  { surface: 'Checkpoints', rest: 'AES-256-GCM, per-org key', transit: 'TLS 1.3, mTLS internally' },
  { surface: 'Event ledgers', rest: 'AES-256-GCM, per-org key', transit: 'TLS 1.3' },
  { surface: 'BYOK vault', rest: 'AES-256-GCM, HSM root', transit: 'TLS 1.3, mTLS only' },
  { surface: 'Console and API', rest: 'n/a', transit: 'TLS 1.3, HSTS' },
  { surface: 'Backups', rest: 'AES-256-GCM, separate key', transit: 'TLS 1.3' },
];

// Composite pill treatments, verbatim; carve-out on the first two rows:
// the composite's "in progress, window closes Q4 2026" and "completed
// 2026-05" assert records that do not exist, so those rows keep the
// current not-yet wording inside the composite's exact pill treatment.
const certs = [
  { name: 'SOC 2 Type II', status: 'not yet claimed', pill: 'text-claret bg-blushBg border-shell' },
  { name: 'Penetration test, external', status: 'not yet published', pill: 'text-slate bg-white border-slate' },
  { name: 'ISO 27001', status: 'not started', pill: 'text-taupe bg-white border-sandDeep' },
  { name: 'HIPAA, FedRAMP', status: 'not started', pill: 'text-taupe bg-white border-sandDeep' },
];

const disclosure = [
  { k: 'First response', v: '1 business day' },
  { k: 'Fix or explanation', v: '30 days' },
  { k: 'Published as a finding', v: 'always' },
  { k: 'Safe harbor', v: 'yes, good faith research' },
];

const threats = [
  {
    tag: 'exposure 1',
    risk: 'A compromised harness image could exfiltrate your workspace.',
    mitigation: 'We wrap images, we do not audit their contents beyond signature and provenance. Community-wrapped images carry more risk than the four we gate, and the compatibility matrix says which is which. Egress from a guest is allowlisted to the gateway, which limits the destination but not the intent.',
  },
  {
    tag: 'exposure 2',
    risk: 'A checkpoint is a complete copy of a machine, including whatever your agent wrote into it.',
    mitigation: 'If your agent writes a secret to disk, that secret is now in every snapshot until retention expires. Credential scanning catches known patterns, not custom ones. Treat a workspace as a place secrets do not belong.',
  },
  {
    tag: 'exposure 3',
    risk: 'We are a young company with a small team and no SOC 2 yet.',
    mitigation: 'That is a real procurement risk and we will not argue otherwise. What we offer instead is the claims file, the findings archive, and a security pack you can read without talking to anyone. Judge us on published evidence rather than on a badge we have not earned.',
  },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans min-h-screen antialiased leading-[normal]">

    <header class="sticky top-0 z-50 bg-paper/[0.94] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-[15px] flex items-center justify-between gap-[22px] flex-wrap">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline hover:text-ink">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
          <span class="font-serif text-[21px] font-medium">KeepState</span>
        </a>
        <div class="flex items-center gap-6 flex-wrap">
          <a href="/product/sessions" class="text-14 text-slate no-underline hover:text-ink">Product</a>
          <a href="/enterprise" class="text-14 text-slate no-underline hover:text-ink">Enterprise</a>
          <a href="/proof" class="text-14 text-slate no-underline hover:text-ink">Proof</a>
          <a href="/status" class="text-14 text-slate no-underline hover:text-ink">Status</a>
          <a href="/enterprise#pack" class="text-14 font-medium text-paper bg-claret px-4 py-[9px] rounded-3 no-underline hover:no-underline hover:text-paper">Security review pack</a>
        </div>
      </nav>
    </header>

    <section class="max-w-[1180px] mx-auto px-7 pt-[68px] pb-11">
      <div class="flex items-center gap-[9px] mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Security</span>
      </div>
      <h1 class="font-serif text-[clamp(38px,5.4vw,60px)] leading-[1.04] tracking-[-0.025em] font-normal m-0 mb-6 max-w-[17em]">The real key never enters a guest, an image, or a snapshot.</h1>
      <p class="text-17 leading-[1.7] text-slate m-0 max-w-[44em] [text-wrap:pretty]">A checkpoint is a copy of a running machine, which makes every secret inside that machine a copy too. So we keep secrets out of the machine. What follows is the architecture, stated as policy rather than as reassurance.</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7">
      <div class="bg-white border border-sand rounded-5 pt-[30px] px-[26px] pb-[30px]">
        <p class="font-mono text-10 tracking-[0.12em] uppercase text-taupe m-0 mb-6">isolation boundary</p>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-4 mb-[22px]">
          {boundary.map((b) => (
            <div class={`border rounded-4 pt-5 px-[18px] pb-5 ${b.card}`}>
              <div class="flex items-center gap-[9px] mb-2.5">
                <span class={`w-[6px] h-[6px] ${b.dot} rotate-45 block`}></span>
                <p class={`font-mono text-12 ${b.titleC} m-0`}>{b.name}</p>
              </div>
              <p class={`text-13 leading-[1.6] ${b.bodyC} m-0 mb-3`}>{b.body}</p>
              <p class={`font-mono text-[10.5px] leading-[1.5] ${b.metaC} m-0`}>{b.meta}</p>
            </div>
          ))}
        </div>
        <p class="text-14 leading-[1.7] text-slate m-0 max-w-[52em]">The guest is the only place your agent's code runs, and it is the only place that never holds a durable credential. A stolen checkpoint yields a filesystem and a conversation, not a way to spend your money.</p>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-16">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3.5">Key handling, stated as rules.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-[30px] max-w-[42em]">These are not aspirations. Each one is enforced in code, and where a gate watches it, the gate is named.</p>
      <div class="border-t border-sand">
        {rules.map((r) => (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-9 gap-y-2.5 py-[22px] px-0.5 border-b border-sand items-start">
            <div class="flex gap-3 items-start">
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block mt-[7px] flex-none"></span>
              <p class="text-16 leading-[1.6] font-medium text-ink m-0">{r.rule}</p>
            </div>
            <p class="text-[14.5px] leading-[1.65] text-slate m-0">{r.detail}</p>
            <div class="flex items-center gap-2 flex-wrap">
              {r.gate
                ? <a href="/proof" class="inline-flex items-center gap-1.5 font-mono text-[11.5px] text-claret no-underline hover:text-ink hover:underline"><span class="w-[5px] h-[5px] bg-claret rotate-45 inline-block"></span>{r.gate}</a>
                : <span class="font-mono text-[11.5px] text-stone">policy, no gate yet</span>}
            </div>
          </div>
        ))}
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-16">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-[22px] items-start">
        <div>
          <h2 class="font-serif text-[clamp(26px,3.2vw,34px)] leading-[1.12] tracking-[-0.02em] font-normal m-0 mb-5">Encryption</h2>
          <div class="bg-white border border-sand rounded-5 overflow-hidden">
            <div class="overflow-x-auto">
              <table class="w-full border-collapse text-13 min-w-[380px]">
                <thead>
                  <tr class="bg-paper">
                    <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-[11px] px-4 border-b border-sand">surface</th>
                    <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-[11px] px-4 border-b border-sand">at rest</th>
                    <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe py-[11px] px-4 border-b border-sand">in transit</th>
                  </tr>
                </thead>
                <tbody>
                  {crypto.map((c) => (
                    <tr class="border-b border-track">
                      <td class="py-3 px-4 text-13 text-ink">{c.surface}</td>
                      <td class="py-3 px-4 font-mono text-[11.5px] text-slate">{c.rest}</td>
                      <td class="py-3 px-4 font-mono text-[11.5px] text-slate">{c.transit}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
          <p class="text-13 leading-[1.65] text-taupe mt-3.5 mx-0.5 mb-0">Checkpoint keys are per-organization and rotated on a 90-day schedule. Enterprise customers may hold the root key themselves, in which case we cannot read a checkpoint even under subpoena.</p>
        </div>

        <div class="grid gap-[22px]">
          <div class="bg-parchment border border-sand rounded-5 pt-[26px] px-6 pb-[26px]">
            <h2 class="font-serif text-[24px] leading-[1.2] font-medium m-0 mb-3.5">Certifications, stated honestly</h2>
            <div class="grid gap-0">
              {certs.map((c) => (
                <div class="flex items-center justify-between gap-3.5 py-[13px] border-t border-sand">
                  <span class="text-14 text-ink">{c.name}</span>
                  <span class={`font-mono text-11 tracking-[0.06em] border rounded-pill py-1 px-[11px] whitespace-nowrap ${c.pill}`}>{c.status}</span>
                </div>
              ))}
            </div>
            <p class="text-[13.5px] leading-[1.65] text-slate mt-[18px] mb-0">No badge appears on this site until the certificate exists. There is no reserved slot waiting to be filled, because a reserved slot is a claim.</p>
          </div>

          <div class="bg-white border border-sand rounded-5 pt-[26px] px-6 pb-[26px]">
            <h2 class="font-serif text-[24px] leading-[1.2] font-medium m-0 mb-3.5">Responsible disclosure</h2>
            <p class="text-14 leading-[1.7] text-slate m-0 mb-[18px]">Report anything that looks like a way past the boundary. We answer within one business day, fix or explain within thirty, and publish the finding in the archive with your name on it unless you ask us not to.</p>
            <div class="bg-ink rounded-4 py-3.5 px-4 mb-4">
              <code class="font-mono text-[12.5px] text-parchment block overflow-x-auto whitespace-nowrap">security@keepstate.ai · PGP 4E91 C02D 7F3A 2C19</code>
            </div>
            <div class="grid gap-0">
              {disclosure.map((d) => (
                <div class="flex items-baseline justify-between gap-3.5 py-[11px] border-t border-track">
                  <span class="text-13 text-slate">{d.k}</span>
                  <span class="font-mono text-12 text-ink">{d.v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-[1180px] mx-auto px-7 pt-16">
      <h2 class="font-serif text-[clamp(26px,3.2vw,34px)] leading-[1.12] tracking-[-0.02em] font-normal m-0 mb-3.5">What we would tell an attacker.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-[26px] max-w-[44em]">The honest version of a threat model names what it does not cover. These are the three places we consider ourselves most exposed today.</p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-[18px]">
        {threats.map((t) => (
          <article class="bg-white border border-sand border-l-[3px] border-l-claret rounded-5 p-[22px]">
            <p class="font-mono text-10 tracking-[0.1em] uppercase text-claret m-0 mb-3">{t.tag}</p>
            <p class="text-15 font-medium leading-[1.5] text-ink m-0 mb-3">{t.risk}</p>
            <p class="text-[13.5px] leading-[1.65] text-slate m-0">{t.mitigation}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-ink mt-[76px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[72px]">
        <div class="max-w-[44em]">
          <h2 class="font-serif text-[clamp(30px,4.2vw,44px)] leading-[1.08] tracking-[-0.02em] font-normal text-paper m-0 mb-[22px]">Read it before you talk to us.</h2>
          <p class="text-17 leading-[1.7] text-borderMuted m-0 mb-[30px]">The DPA, the subprocessor list, the architecture overview, and the penetration test summary download together, with <span class="text-blush">no form and no call first</span>.</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="/enterprise#pack" class="text-15 font-medium text-paper bg-claret px-[22px] py-[13px] rounded-3 no-underline hover:no-underline hover:text-paper">Download the security review pack</a>
            <a href="/status" class="text-15 font-medium text-paper border border-inkLine px-[21px] py-3 rounded-3 no-underline hover:no-underline hover:text-paper">Status and incident history</a>
          </div>
          <p class="font-mono text-11 tracking-[0.1em] text-termMuted mt-[30px] mb-0">keepstate.ai · the durable agent session cloud</p>
        </div>
      </div>
    </section>
    <Footer variant="marketing" />
  </body>
</html>
