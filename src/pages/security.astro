---
// Security: the posture page, from design/Security.dc.html.
// Carried verbatim (dedashed). The composite's gate tags G-151..G-154 do
// not exist in src/generated/proof.json, so per UI Law 2 no rule cites a
// gate it cannot prove: every rule renders the composite's own honest
// fallback ("policy, no gate yet") until the real tags land on /proof.
// The composite's sample PGP fingerprint is likewise not shipped as fact.
import Site from '../layouts/Site.astro';

const boundary = [
  {
    name: 'BYOK vault',
    body: 'Your real provider key, encrypted per organization, outside the isolation boundary and unreachable from any guest.',
    meta: 'AES-256-GCM · HSM-backed root · no read path from the data plane',
    card: 'bg-blushBg border-shell', dot: 'bg-claret', title: 'text-claret', bodyC: 'text-slate', metaC: 'text-taupe',
  },
  {
    name: 'Gateway',
    body: 'Mints a virtual key scoped to one session, meters every call, and enforces exactly-once billing on our side of the wire.',
    meta: 'virtual keys expire at session end · never handled by a human',
    card: 'bg-white border-sand', dot: 'bg-slate', title: 'text-ink', bodyC: 'text-slate', metaC: 'text-taupe',
  },
  {
    name: 'Micro-VM guest',
    body: 'The agent, its filesystem, its tools. Hardware-virtualized, one tenant, no shared kernel. Sees the virtual key only.',
    meta: 'egress allowlisted to the gateway · no inbound path',
    card: 'bg-ink border-ink', dot: 'bg-blush', title: 'text-blush', bodyC: 'text-borderMuted', metaC: 'text-termMuted',
  },
  {
    name: 'Checkpoint store',
    body: 'Content-addressed, encrypted at rest, pinned to the region you named. Contains no live credential by construction.',
    meta: 'per-org keys · region enforced at the scheduler',
    card: 'bg-parchment border-sand', dot: 'bg-stone', title: 'text-ink', bodyC: 'text-slate', metaC: 'text-taupe',
  },
];

const rules = [
  { rule: 'A provider key is never written into a guest.',
    detail: 'The vault has no read path from the data plane. A guest that asks for a key gets a virtual key, or nothing.' },
  { rule: 'A checkpoint is scanned for credential material before it is acknowledged.',
    detail: 'If a secret pattern appears in a snapshot, the checkpoint is quarantined and the session is halted rather than silently stored.' },
  { rule: 'Virtual keys are scoped to one session and die with it.',
    detail: 'Scope covers the session id, the model set you authorized, and the budget remaining. A leaked virtual key buys nothing after the session ends.' },
  { rule: 'Humans never handle a virtual key.',
    detail: 'They are minted, injected, and revoked by the gateway. No console screen displays one, and no support process asks for one.' },
  { rule: 'A revoked key stops working mid-session.',
    detail: 'Revocation is immediate at the gateway, not on next issue. The session checkpoints and parks rather than continuing on a credential you withdrew.' },
  { rule: 'Support staff cannot read your checkpoints.',
    detail: 'Access requires a break-glass path that notifies your Owners, writes to your audit log, and expires in one hour. Enterprise customers holding their own root key can make it impossible outright.' },
];

const crypto = [
  { surface: 'Checkpoints', rest: 'AES-256-GCM, per-org key', transit: 'TLS 1.3, mTLS internally' },
  { surface: 'Event ledgers', rest: 'AES-256-GCM, per-org key', transit: 'TLS 1.3' },
  { surface: 'BYOK vault', rest: 'AES-256-GCM, HSM root', transit: 'TLS 1.3, mTLS only' },
  { surface: 'Console and API', rest: 'n/a', transit: 'TLS 1.3, HSTS' },
  { surface: 'Backups', rest: 'AES-256-GCM, separate key', transit: 'TLS 1.3' },
];

const certs = [
  { name: 'SOC 2 Type II', status: 'not yet claimed', pill: 'text-taupe bg-white border-sandDeep' },
  { name: 'Penetration test, external', status: 'not yet published', pill: 'text-taupe bg-white border-sandDeep' },
  { name: 'ISO 27001', status: 'not started', pill: 'text-taupe bg-white border-sandDeep' },
  { name: 'HIPAA, FedRAMP', status: 'not started', pill: 'text-taupe bg-white border-sandDeep' },
];

const disclosure = [
  { k: 'First response', v: '1 business day' },
  { k: 'Fix or explanation', v: '30 days' },
  { k: 'Published as a finding', v: 'always' },
  { k: 'Safe harbor', v: 'yes, good faith research' },
];

const threats = [
  {
    tag: 'exposure 1',
    risk: 'A compromised harness image could exfiltrate your workspace.',
    mitigation: 'We wrap images, we do not audit their contents beyond signature and provenance. Community-wrapped images carry more risk than the four we gate, and the compatibility matrix says which is which. Egress from a guest is allowlisted to the gateway, which limits the destination but not the intent.',
  },
  {
    tag: 'exposure 2',
    risk: 'A checkpoint is a complete copy of a machine, including whatever your agent wrote into it.',
    mitigation: 'If your agent writes a secret to disk, that secret is now in every snapshot until retention expires. Credential scanning catches known patterns, not custom ones. Treat a workspace as a place secrets do not belong.',
  },
  {
    tag: 'exposure 3',
    risk: 'We are a young company with a small team and no SOC 2 yet.',
    mitigation: 'That is a real procurement risk and we will not argue otherwise. What we offer instead is the claims file, the findings archive, and a security pack you can read without talking to anyone. Judge us on published evidence rather than on a badge we have not earned.',
  },
];
---
<Site title="Security · KeepState" description="The KeepState isolation boundary: the real key never enters a guest, an image, or a snapshot. Key handling stated as rules, encryption surfaces, certifications stated honestly, and responsible disclosure.">
  <main class="max-w-[1180px] mx-auto px-7">

    <section class="pt-14 pb-11">
      <div class="flex items-center gap-2 mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Security</span>
      </div>
      <h1 class="font-serif text-34 font-normal leading-[1.08] tracking-[-0.02em] mt-0 mb-6 max-w-[17em]">The real key never enters a guest, an image, or a snapshot.</h1>
      <p class="text-17 leading-relaxed text-slate m-0 max-w-[44em]">A checkpoint is a copy of a running machine, which makes every secret inside that machine a copy too. So we keep secrets out of the machine. What follows is the architecture, stated as policy rather than as reassurance.</p>
    </section>

    <section>
      <div class="bg-white border border-sand rounded-5 p-7">
        <p class="font-mono text-10 tracking-[0.12em] uppercase text-taupe mt-0 mb-6">isolation boundary</p>
        <div class="grid md:grid-cols-2 xl:grid-cols-4 gap-4 mb-5">
          {boundary.map((b) => (
            <div class={`border rounded-4 px-4 py-5 ${b.card}`}>
              <div class="flex items-center gap-2 mb-2.5">
                <span class={`w-[6px] h-[6px] rotate-45 block ${b.dot}`}></span>
                <p class={`font-mono text-12 m-0 ${b.title}`}>{b.name}</p>
              </div>
              <p class={`text-13 leading-relaxed m-0 mb-3 ${b.bodyC}`}>{b.body}</p>
              <p class={`font-mono text-10 leading-normal m-0 ${b.metaC}`}>{b.meta}</p>
            </div>
          ))}
        </div>
        <p class="text-14 leading-relaxed text-slate m-0 max-w-[52em]">The guest is the only place your agent's code runs, and it is the only place that never holds a durable credential. A stolen checkpoint yields a filesystem and a conversation, not a way to spend your money.</p>
      </div>
    </section>

    <section class="pt-16">
      <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-3.5">Key handling, stated as rules.</h2>
      <p class="text-15 leading-relaxed text-slate mt-0 mb-7 max-w-[42em]">These are not aspirations. Each one is enforced in code, and where a gate watches it, the gate is named.</p>
      <div class="border-t border-sand">
        {rules.map((r) => (
          <div class="grid md:grid-cols-[1fr_1fr_auto] gap-x-9 gap-y-2.5 py-5 px-0.5 border-b border-sand items-start">
            <div class="flex gap-3 items-start">
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block mt-[7px] shrink-0"></span>
              <p class="text-16 leading-relaxed font-medium text-ink m-0">{r.rule}</p>
            </div>
            <p class="text-14 leading-relaxed text-slate m-0">{r.detail}</p>
            <span class="font-mono text-11 text-stone whitespace-nowrap">policy, no gate yet</span>
          </div>
        ))}
      </div>
      <p class="font-mono text-11 text-taupe mt-3 mb-0">the gate tags for key handling publish to <a href="/proof" class="text-claret no-underline hover:underline">/proof</a> as each one goes green; a rule never cites a gate this site cannot show you</p>
    </section>

    <section class="pt-16">
      <div class="grid lg:grid-cols-2 gap-6 items-start">
        <div>
          <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-5">Encryption</h2>
          <figure class="m-0 overflow-x-auto">
            <table class="w-full border-collapse bg-white border border-sand rounded-4 text-13 min-w-[380px]">
              <thead>
                <tr class="bg-paper">
                  <th class="text-left font-mono text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-4 py-3 border-b border-sand">surface</th>
                  <th class="text-left font-mono text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-4 py-3 border-b border-sand">at rest</th>
                  <th class="text-left font-mono text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-4 py-3 border-b border-sand">in transit</th>
                </tr>
              </thead>
              <tbody>
                {crypto.map((c) => (
                  <tr class="border-b border-track last:border-0">
                    <td class="px-4 py-3 text-13 text-ink">{c.surface}</td>
                    <td class="px-4 py-3 font-mono text-11 text-slate">{c.rest}</td>
                    <td class="px-4 py-3 font-mono text-11 text-slate">{c.transit}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </figure>
          <p class="text-13 leading-relaxed text-taupe mt-3.5 mb-0 px-0.5">Checkpoint keys are per-organization and rotated on a 90-day schedule. Enterprise customers may hold the root key themselves, in which case we cannot read a checkpoint even under subpoena.</p>
        </div>

        <div class="grid gap-6">
          <div class="bg-parchment border border-sand rounded-5 p-6">
            <h2 class="font-serif text-22 font-medium leading-tight mt-0 mb-3.5">Certifications, stated honestly</h2>
            <div class="grid gap-0">
              {certs.map((c) => (
                <div class="flex items-center justify-between gap-3.5 py-3 border-t border-sand">
                  <span class="text-14 text-ink">{c.name}</span>
                  <span class={`font-mono text-11 tracking-[0.06em] border rounded-pill px-2.5 py-1 whitespace-nowrap ${c.pill}`}>{c.status}</span>
                </div>
              ))}
            </div>
            <p class="text-13 leading-relaxed text-slate mt-4 mb-0">No badge appears on this site until the certificate exists. There is no reserved slot waiting to be filled, because a reserved slot is a claim.</p>
          </div>

          <div class="bg-white border border-sand rounded-5 p-6">
            <h2 class="font-serif text-22 font-medium leading-tight mt-0 mb-3.5">Responsible disclosure</h2>
            <p class="text-14 leading-relaxed text-slate mt-0 mb-4">Report anything that looks like a way past the boundary. We answer within one business day, fix or explain within thirty, and publish the finding in the archive with your name on it unless you ask us not to.</p>
            <div class="bg-ink rounded-4 px-4 py-3.5 mb-4">
              <code class="font-mono text-12 text-parchment block overflow-x-auto whitespace-nowrap">security@keepstate.ai · PGP fingerprint: not yet published</code>
            </div>
            <div class="grid gap-0">
              {disclosure.map((d) => (
                <div class="flex items-baseline justify-between gap-3.5 py-2.5 border-t border-track">
                  <span class="text-13 text-slate">{d.k}</span>
                  <span class="font-mono text-12 text-ink">{d.v}</span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="pt-16 pb-4">
      <h2 class="font-serif text-26 font-normal leading-tight tracking-[-0.02em] mt-0 mb-3.5">What we would tell an attacker.</h2>
      <p class="text-15 leading-relaxed text-slate mt-0 mb-6 max-w-[44em]">The honest version of a threat model names what it does not cover. These are the three places we consider ourselves most exposed today.</p>
      <div class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
        {threats.map((t) => (
          <article class="bg-white border border-sand border-l-[3px] border-l-claret rounded-5 p-5">
            <p class="font-mono text-10 tracking-[0.1em] uppercase text-claret mt-0 mb-3">{t.tag}</p>
            <p class="text-15 font-medium leading-normal text-ink mt-0 mb-3">{t.risk}</p>
            <p class="text-13 leading-relaxed text-slate m-0">{t.mitigation}</p>
          </article>
        ))}
      </div>
    </section>
  </main>

  <section class="bg-ink mt-[76px]">
    <div class="max-w-[1180px] mx-auto px-7 py-16">
      <div class="max-w-[44em]">
        <h2 class="font-serif text-34 font-normal leading-[1.08] tracking-[-0.02em] text-paper mt-0 mb-5">Read it before you talk to us.</h2>
        <p class="text-17 leading-relaxed text-borderMuted mt-0 mb-7">The DPA, the subprocessor list, and the architecture overview will download together, with <span class="text-blush">no form and no call first</span>.</p>
        <div class="flex gap-3.5 flex-wrap">
          <a href="/enterprise" class="text-15 font-medium text-paper bg-claret px-5 py-3 rounded-3 no-underline hover:bg-claretDeep">Download the security review pack</a>
          <a href="/status" class="text-15 font-medium text-paper border border-inkSoft px-5 py-3 rounded-3 no-underline hover:border-termMuted">Status and incident history</a>
        </div>
        <p class="font-mono text-11 tracking-[0.1em] text-termMuted mt-7 mb-0">keepstate.ai · the durable agent session cloud</p>
      </div>
    </div>
  </section>
</Site>
