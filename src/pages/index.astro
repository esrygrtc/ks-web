---
// The home page, 1:1 from design/KeepState.dc.html. This page carries its
// OWN header and footer because the composite does; every section, color,
// size, and animation below mirrors the composite's inline styles and
// DCLogic behavior (terminal typewriter loop, fork draw-in, econ count-up).
import '../styles/fonts.css';
import tokens from '../../design/tokens.json';
const c = tokens.color;
const title = 'KeepState · Your agents never start over.';
const description = 'KeepState runs your AI agents inside snapshot-able micro-VMs. One API: run, checkpoint, fork, resume, replay. Any model, any harness.';
const canonical = new URL('/', Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans min-h-screen antialiased">

    <header class="sticky top-0 z-50 bg-paper/[0.92] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-4 flex items-center justify-between gap-6 flex-wrap">
        <a href="#top" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline hover:text-ink">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block ks-pulse"></span>
          <span class="font-serif text-[21px] font-medium tracking-[-0.01em]">KeepState</span>
        </a>
        <div class="flex items-center gap-7 flex-wrap">
          <a href="#product" class="text-14 text-slate no-underline hover:text-ink">Product</a>
          <a href="#whynow" class="text-14 text-slate no-underline hover:text-ink">Why now</a>
          <a href="/manifesto" class="text-14 text-slate no-underline hover:text-ink">Manifesto</a>
          <a href="/docs" class="text-14 text-slate no-underline hover:text-ink">Docs</a>
          <a href="#partner" class="text-14 font-medium text-paper bg-claret px-4 py-[9px] rounded-3 no-underline hover:no-underline hover:text-paper">Start building</a>
        </div>
      </nav>
    </header>

    <!-- hero -->
    <section id="top" class="max-w-[1180px] mx-auto px-7 pt-[72px] pb-16">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,400px),1fr))] gap-14 items-start">
        <div class="max-w-[32em]">
          <div class="flex items-center gap-[9px] mb-[22px]">
            <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
            <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">The durable agent session cloud</span>
          </div>
          <h1 class="font-serif text-[clamp(42px,6.4vw,74px)] leading-[1.02] tracking-[-0.025em] font-normal m-0 mb-[26px]">Your agents never start over.</h1>
          <p class="text-[18px] leading-[1.62] text-slate m-0 mb-[18px] [text-wrap:pretty]">KeepState runs your AI agents inside snapshot-able micro-VMs. One API: run, checkpoint, fork, resume, replay. Any model, any harness.</p>
          <p class="font-serif italic text-17 leading-[1.55] text-ink m-0 mb-[34px] pl-4 border-l-2 border-sand">An agent that dies at hour five is a bill. An agent that resumes is an employee.</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="#partner" class="text-15 font-medium text-paper bg-claret px-[22px] py-[13px] rounded-3 no-underline hover:no-underline hover:text-paper">Start building</a>
            <a href="#demo" class="text-15 font-medium text-ink bg-paper/0 border border-sand px-[21px] py-3 rounded-3 no-underline hover:no-underline hover:text-ink">Watch the plug get pulled</a>
          </div>
        </div>
        <div id="demo" class="relative">
          <div class="bg-ink border border-inkBorder rounded-[7px] pt-5 px-[22px] pb-6 shadow-[0_18px_40px_-22px_rgba(22,19,15,0.45)] relative overflow-hidden">
            <div class="flex items-center justify-between border-b border-inkBorder pb-[13px] mb-4">
              <span class="font-mono text-11 tracking-[0.12em] uppercase text-termMuted">ks · live session</span>
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
            </div>
            <div id="term" class="font-mono text-13 leading-[1.55] h-[250px] overflow-y-auto overflow-x-hidden [scrollbar-width:none]"></div>
            <div id="term-flash" class="absolute inset-0 bg-claret pointer-events-none opacity-0"></div>
          </div>
          <p class="font-mono text-11 text-termMuted mt-3 mx-0.5 mb-0 tracking-[0.04em]">recorded session · replayed on loop</p>
        </div>
      </div>
    </section>

    <!-- partner strip -->
    <section class="bg-parchment border-t border-b border-sand">
      <div class="max-w-[1180px] mx-auto px-7 py-[26px] flex items-center gap-9 flex-wrap justify-between">
        <p class="m-0 text-14 text-slate font-medium">Backed by builders. Run by design partners.</p>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(112px,1fr))] gap-3.5 flex-[1_1_460px]">
          {[1, 2, 3, 4, 5].map(() => (
            <div class="h-[38px] border border-dashed border-borderMuted rounded-3 flex items-center justify-center font-mono text-9 tracking-[0.1em] uppercase text-mist bg-[repeating-linear-gradient(135deg,rgba(22,19,15,0.03)_0_4px,transparent_4px_8px)]">design partner</div>
          ))}
        </div>
      </div>
    </section>

    <!-- the problem -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[84px]">
      <div class="flex items-center gap-[9px] mb-[18px]">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">The problem</span>
      </div>
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-11 max-w-[20em]">Agents die mid-task. You pay twice.</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-[22px]">
        {[
          { stat: 'hour 5', head: 'where the 6-hour run dies', body: 'Sandbox crash, rate limit, provider blip. Everything gone. Restart from zero.' },
          { stat: '50–70%', head: 'of the token bill is replay', body: 'The same context, re-sent to the model step after step after step.' },
          { stat: '5 systems', head: 'duct-taped per team', body: 'Framework, sandbox, workflow engine, state store, per-vendor caches.' },
        ].map((c) => (
          <div class="bg-white border border-sand rounded-5 pt-[26px] px-6 pb-7 shadow-[0_12px_26px_-20px_rgba(22,19,15,0.35)]">
            <p class="font-mono text-[30px] text-claret m-0 mb-2.5 tracking-[-0.02em]">{c.stat}</p>
            <p class="text-14 font-semibold text-ink m-0 mb-3">{c.head}</p>
            <p class="text-14 leading-[1.6] text-slate m-0">{c.body}</p>
          </div>
        ))}
      </div>
      <p class="font-serif italic text-20 leading-[1.5] text-ink text-center mt-11 mx-auto mb-0 max-w-[30em]">Every serious agent team rebuilds this privately. None of them wants to.</p>
    </section>

    <!-- the product -->
    <section id="product" class="max-w-[1180px] mx-auto px-7 pt-[88px]">
      <div class="flex items-center gap-[9px] mb-[18px]">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">The product</span>
      </div>
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-[30px] max-w-[20em]">One API. Autosave for AI agents.</h2>
      <div class="bg-ink rounded-5 py-[18px] px-6 mb-[30px] font-mono text-15 text-parchment tracking-[0.06em] overflow-x-auto whitespace-nowrap">run · checkpoint · fork · resume · replay</div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,232px),1fr))] gap-[18px]">
        {[
          { verb: 'run', body: 'Point any agent at KeepState. Same models, same code.', cmd: 'ks run --image claude-code' },
          { verb: 'checkpoint', body: 'Filesystem + model memory + tool state. One atomic snapshot.', cmd: 'ks save s_7f3a' },
          { verb: 'fork', body: 'Branch step 40 into six universes. Keep the winner.', cmd: 'ks fork s_7f3a@40 -n 6' },
          { verb: 'resume', body: 'Warm resume under 100 ms. Cold under 90 s. On any provider.', cmd: 'ks wake s_7f3a' },
          { verb: 'replay', body: 'Re-execute what actually happened. Evidence, not logs.', cmd: 'ks replay s_7f3a' },
        ].map((c) => (
          <div class="bg-white border border-sand rounded-5 pt-[22px] px-5 pb-6 flex flex-col gap-3">
            <span class="w-2 h-2 bg-claret rotate-45 block"></span>
            <p class="font-serif text-[24px] font-medium m-0 tracking-[-0.01em]">{c.verb}</p>
            <p class="text-14 leading-[1.6] text-slate m-0 flex-1">{c.body}</p>
            <code class="font-mono text-12 text-claret bg-blushBg rounded-3 py-2 px-2.5 block overflow-x-auto whitespace-nowrap">{c.cmd}</code>
          </div>
        ))}
      </div>
    </section>

    <!-- three states, one freeze -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[88px]">
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-11 max-w-[20em]">Three states. One freeze.</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] gap-[52px] items-start">
        <div>
          <div class="flex items-stretch gap-2.5 flex-nowrap">
            {['filesystem', 'KV cache', 'tool state'].map((label, i) => (
              <>
                {i > 0 && <div class="flex-none flex items-center font-mono text-16 text-mist">+</div>}
                <div class="flex-[1_1_84px] min-w-0 bg-white border border-sand rounded-4 py-[18px] px-3.5 text-center">
                  <p class="font-mono text-12 text-ink m-0 tracking-[0.02em]">{label}</p>
                </div>
              </>
            ))}
          </div>
          <div class="flex justify-center py-3.5"><span class="block w-px h-[34px] bg-sand"></span></div>
          <div class="bg-blushBg border border-shell rounded-4 p-[22px] flex items-center justify-center gap-3">
            <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
            <p class="font-mono text-14 text-claret m-0 tracking-[0.02em]">one atomic checkpoint</p>
          </div>
          <p class="text-14 leading-[1.6] text-slate mt-4 mb-0">Kill it anywhere. Resume anywhere. The world and the memory can never disagree.</p>
        </div>
        <p class="text-17 leading-[1.7] text-slate m-0 max-w-[34em] [text-wrap:pretty]">Claude Code's own resume is a quest log: your notes survive, the world resets. KeepState is a save state: the running tests, the dev server, the half-finished thought, frozen mid-frame and thawed intact.</p>
      </div>
    </section>

    <!-- fork door -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[88px]">
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-[34px] max-w-[22em]">Every checkpoint is a door to six futures.</h2>
      <div class="bg-white border border-sand rounded-5 pt-[26px] px-6 pb-[26px]">
        <svg id="fork-svg" viewBox="0 0 620 210" class="w-full h-auto block overflow-visible" role="img" aria-label="Session timeline with checkpoints branching into three forks">
          <line x1="14" y1="40" x2="606" y2="40" stroke={c.sand} stroke-width="1"></line>
          <path class="fork-path" d="M300 40 C 380 40, 400 80, 520 80" fill="none" stroke={c.claret} stroke-width="1.5" stroke-dasharray="260" stroke-dashoffset="320" style="transition: stroke-dashoffset 900ms ease-out;"></path>
          <path class="fork-path" d="M300 40 C 380 40, 400 130, 520 130" fill="none" stroke={c.claret} stroke-width="1.5" stroke-dasharray="280" stroke-dashoffset="320" style="transition: stroke-dashoffset 900ms ease-out 120ms;"></path>
          <path class="fork-path" d="M300 40 C 380 40, 400 180, 520 180" fill="none" stroke={c.claret} stroke-width="1.5" stroke-dasharray="300" stroke-dashoffset="320" style="transition: stroke-dashoffset 900ms ease-out 240ms;"></path>
          <rect x="56" y="34" width="12" height="12" fill={c.claret} transform="rotate(45 62 40)"></rect>
          <rect x="174" y="34" width="12" height="12" fill={c.claret} transform="rotate(45 180 40)"></rect>
          <rect x="294" y="32" width="16" height="16" fill={c.claret} transform="rotate(45 302 40)"></rect>
          <rect x="414" y="34" width="12" height="12" fill={c.sand} transform="rotate(45 420 40)"></rect>
          <rect x="534" y="34" width="12" height="12" fill={c.sand} transform="rotate(45 540 40)"></rect>
          <rect x="514" y="74" width="12" height="12" fill={c.claret} transform="rotate(45 520 80)"></rect>
          <rect x="514" y="124" width="12" height="12" fill={c.claret} transform="rotate(45 520 130)"></rect>
          <rect x="514" y="174" width="12" height="12" fill={c.claret} transform="rotate(45 520 180)"></rect>
          <text x="284" y="20" font-family="'JetBrains Mono', monospace" font-size="11" fill={c.claret}>step 40</text>
        </svg>
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,220px),1fr))] gap-3 mt-[22px]">
          <div class="bg-ink rounded-4 py-3 px-3.5 font-mono text-11 text-blush overflow-x-auto whitespace-nowrap">--steer "one big migration"</div>
          <div class="bg-ink rounded-4 py-3 px-3.5 font-mono text-11 text-blush overflow-x-auto whitespace-nowrap">--steer "keep legacy adapter"</div>
          <div class="bg-ink rounded-4 py-3 px-3.5 font-mono text-11 text-blush overflow-x-auto whitespace-nowrap">--steer "split by tenant"</div>
        </div>
      </div>
      <p class="text-17 leading-[1.7] text-slate mt-[26px] mb-0 max-w-[42em] [text-wrap:pretty]">Fork a two-day-old freeze ten times. The API is stateless; each fork is just a conversation that went differently. Your bill is the only one who notices.</p>
    </section>

    <!-- token bill -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[88px]">
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-11 max-w-[22em]">The token bill drops the week you switch.</h2>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-12 items-center">
        <div>
          <p id="econ" class="font-mono text-[clamp(64px,9vw,104px)] leading-none text-claret m-0 mb-3.5 tracking-[-0.04em]">&minus;0%</p>
          <p class="text-15 leading-[1.6] text-slate m-0 max-w-[22em]">cost on the identical trace, measured, not vibed.</p>
        </div>
        <div class="flex flex-col">
          {['Cache-aware routing across providers.', 'Stored-response replay: never pay twice for an interrupted call.', "Budget caps: ten forks can't detonate your card."].map((t, i) => (
            <div class={`flex gap-3 py-4 border-t border-sand ${i === 2 ? 'border-b' : ''}`}>
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block mt-[7px] flex-none"></span>
              <p class="text-15 leading-[1.6] text-ink m-0">{t}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- governance -->
    <section class="bg-slate mt-[88px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[76px]">
        <div class="flex items-center gap-[9px] mb-5">
          <span class="w-[7px] h-[7px] bg-blush rotate-45 block"></span>
          <span class="text-11 font-semibold tracking-[0.16em] uppercase text-blush">Governance</span>
        </div>
        <h2 class="font-serif text-[clamp(30px,4vw,44px)] leading-[1.1] tracking-[-0.02em] font-normal text-paper m-0 mb-[26px] max-w-[28em]">Logs tell you what the agent said it did. Replay re-executes what it actually did.</h2>
        <p class="text-17 leading-[1.7] text-slateSoft m-0 mb-[26px] max-w-[40em] [text-wrap:pretty]">Deterministic replay from checkpointed state. Audit trails with sequence lineage. Deposition-grade evidence for the compliance officer, zero extra work for the engineer.</p>
        <span class="inline-block font-mono text-11 tracking-[0.08em] text-paper border border-slateLine rounded-3 py-[7px] px-3">Enterprise: sovereign deploys, retention, SSO.</span>
      </div>
    </section>

    <!-- why now -->
    <section id="whynow" class="max-w-[1180px] mx-auto px-7 pt-[88px]">
      <div class="flex items-center gap-[9px] mb-[18px]">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">Why now</span>
      </div>
      <h2 class="font-serif text-[clamp(32px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal m-0 mb-10 max-w-[20em]">Counting the OOMs of agent-hours.</h2>
      <div class="flex flex-col">
        {[
          { lead: '2× every ~7 months', body: 'Agent task horizons keep doubling. Minutes became hours. Hours become days.', last: false },
          { lead: 'The #1 AI cost line', body: 'Inference-time compute now outweighs everything else in the agent economy.', last: false },
          { lead: 'Agents got hands', body: 'MCP standardized tools. Long tasks became the default, not the demo.', last: true },
        ].map((r) => (
          <div class={`grid grid-cols-[repeat(auto-fit,minmax(min(100%,260px),1fr))] gap-x-10 gap-y-2.5 py-[22px] border-t border-sand items-start ${r.last ? 'border-b' : ''}`}>
            <div class="flex gap-3 items-baseline">
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block flex-none"></span>
              <p class="font-mono text-17 text-claret m-0">{r.lead}</p>
            </div>
            <p class="text-16 leading-[1.6] text-slate m-0">{r.body}</p>
          </div>
        ))}
      </div>
      <p class="font-serif italic text-[19px] leading-[1.55] text-ink mt-8 mb-0 max-w-[34em]">What the 2024 forecasts called unhobbling is now a workload. Its substrate is unowned.</p>
    </section>

    <!-- manifesto teaser -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[100px] pb-24">
      <div class="max-w-[62ch] mx-auto">
        <div class="flex justify-center mb-[30px]"><span class="w-2.5 h-2.5 bg-claret rotate-45 block"></span></div>
        <p class="font-serif text-[clamp(30px,4vw,44px)] leading-[1.16] tracking-[-0.02em] m-0 mb-[30px] text-center">fal taxes generative media. KeepState taxes agent-hours.</p>
        <p class="text-[18px] leading-[1.75] text-slate m-0 mb-7 [text-wrap:pretty]">Every long-running task in the world is becoming a session: metered, durable, forkable, replayable. We are building the layer that keeps that state, the way the caravanserai kept the caravans: the place where long journeys checkpoint for the night and continue at dawn. The open session protocol is named han in its honor.</p>
        <a href="/manifesto" class="text-16 font-medium text-claret">Read the manifesto: The Session Economy &rarr;</a>
      </div>
    </section>

    <!-- partner CTA -->
    <section id="partner" class="bg-ink">
      <div class="max-w-[1180px] mx-auto px-7 py-[84px]">
        <div class="max-w-[46em]">
          <h2 class="font-serif text-[clamp(32px,4.4vw,50px)] leading-[1.08] tracking-[-0.02em] font-normal text-paper m-0 mb-6">Send us one trace of your longest run.</h2>
          <p class="text-[18px] leading-[1.7] text-borderMuted m-0 mb-[34px] [text-wrap:pretty]">Within two weeks we <span class="text-blush">pull the plug on your agent, live</span>, and hand you the cost model of what you'd save.</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="/contact" class="text-15 font-medium text-paper bg-claret px-[22px] py-[13px] rounded-3 no-underline hover:no-underline hover:text-paper">Become a design partner</a>
            <a href="/docs" class="text-15 font-medium text-paper border border-inkLine px-[21px] py-3 rounded-3 no-underline hover:no-underline hover:text-paper">Read the docs</a>
          </div>
          <p class="font-mono text-11 tracking-[0.1em] text-termMuted mt-[34px] mb-0">keepstate.ai · the durable agent session cloud</p>
        </div>
      </div>
    </section>

    <!-- footer (the home composite's own) -->
    <footer id="docs-foot" class="border-t border-sand">
      <div class="max-w-[1180px] mx-auto px-7 pt-[60px] pb-10">
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,190px),1fr))] gap-9">
          <div class="flex flex-col gap-3">
            <p class="text-11 font-semibold tracking-[0.16em] uppercase text-claret m-0 mb-1">Product</p>
            <a href="/docs" class="text-14 text-slate no-underline hover:text-ink">Docs</a>
            <a href="/docs/cli" class="text-14 text-slate no-underline hover:text-ink">CLI</a>
            <a href="/status" class="text-14 text-slate no-underline hover:text-ink">Status</a>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-11 font-semibold tracking-[0.16em] uppercase text-claret m-0 mb-1">Company</p>
            <a href="/manifesto" class="text-14 text-slate no-underline hover:text-ink">Manifesto</a>
            <a href="/careers" class="text-14 text-slate no-underline hover:text-ink">Careers</a>
            <p class="text-13 leading-[1.5] text-taupe -mt-1 mb-0">Hiring engineer #1: virtualization and storage</p>
            <a href="/contact" class="text-14 text-slate no-underline hover:text-ink">Contact</a>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-11 font-semibold tracking-[0.16em] uppercase text-claret m-0 mb-1">Protocol</p>
            <p class="text-14 leading-[1.5] text-slate m-0">han, the open session protocol</p>
            <a href="/docs/api" class="text-14 text-slate no-underline hover:text-ink">Spec</a>
          </div>
          <div class="flex flex-col gap-3">
            <p class="text-11 font-semibold tracking-[0.16em] uppercase text-claret m-0 mb-1">Legal</p>
            <a href="/legal/terms" class="text-14 text-slate no-underline hover:text-ink">Terms</a>
            <a href="/legal/privacy" class="text-14 text-slate no-underline hover:text-ink">Privacy</a>
            <a href="/security" class="text-14 text-slate no-underline hover:text-ink">Security</a>
          </div>
        </div>
        <div class="flex items-center gap-2.5 mt-12 pt-[22px] border-t border-sand">
          <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
          <p class="font-mono text-11 tracking-[0.08em] text-taupe m-0">&copy; KeepState</p>
        </div>
      </div>
    </footer>

    <style>
      @keyframes ksPulse { 0% { transform: rotate(45deg) scale(0.6); opacity: 0; } 60% { transform: rotate(45deg) scale(1.18); opacity: 1; } 100% { transform: rotate(45deg) scale(1); opacity: 1; } }
      @keyframes ksBlink { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
      .ks-pulse { animation: ksPulse 700ms ease-out both; }
      .ks-cursor { display: inline-block; width: 7px; height: 14px; background: theme(colors.blush); vertical-align: -2px; margin-left: 3px; animation: ksBlink 1s step-end infinite; }
      .ks-mark { display: inline-block; width: 6px; height: 6px; background: theme(colors.claret); transform: rotate(45deg); margin: 0 6px 0 2px; vertical-align: middle; }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }
    </style>

    <script define:vars={{ pal: { cmd: c.paper, dim: c.termMuted, work: c.blush, ok: c.parchment, plain: c.parchment } }}>
      // The hero terminal: the composite's DCLogic loop, verbatim behavior.
      // Typewriter at 26 ms/char, elapsed counter ticking, claret flash on
      // the kill, diamond mark on the restore line, blinking cursor on the
      // last line, 4 s hold, loop. Reduced motion gets the final frame.
      const term = document.getElementById('term');
      const flashEl = document.getElementById('term-flash');
      const tones = { cmd: pal.cmd, dim: pal.dim, work: pal.work, ok: pal.ok };
      const reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      let lines = [];
      let alive = true;

      const render = () => {
        if (!term) return;
        term.innerHTML = lines.map((l, i) => {
          const cursor = !reduced && i === lines.length - 1 ? '<span class="ks-cursor"></span>' : '';
          const mark = l.mark ? '<span class="ks-mark"></span>' : '';
          const t2 = l.text2 ? `<span style="color:${pal.dim}">${l.text2}</span>` : '';
          return `<div style="word-break:break-word;color:${pal.plain}"><span style="white-space:pre-wrap;color:${tones[l.tone] ?? pal.plain}">${l.text}</span>${mark}${t2}${cursor}</div>`;
        }).join('');
        term.scrollTop = term.scrollHeight;
      };
      const wait = (ms) => new Promise((r) => setTimeout(r, ms));
      const push = (l) => { lines.push(l); render(); };
      const patchLast = (p) => { Object.assign(lines[lines.length - 1], p); render(); };
      const type = async (text, tone) => {
        push({ text: '', tone });
        for (let i = 1; i <= text.length; i++) {
          if (!alive) return;
          patchLast({ text: text.slice(0, i) });
          await wait(26);
        }
      };
      const fmt = (s) => {
        const p = (n) => String(n).padStart(2, '0');
        return p(Math.floor(s / 3600)) + ':' + p(Math.floor((s % 3600) / 60)) + ':' + p(s % 60);
      };
      const finalFrame = () => [
        { text: '$ ks run --image claude-code --workspace ./payments-migration', tone: 'cmd' },
        { text: 'session s_7f3a started · checkpointing every 5m', tone: 'dim' },
        { text: '[agent working · 04:58:12 elapsed · 312 files touched]', tone: 'work' },
        { text: '$ kill -9 14203            # the plug, pulled', tone: 'cmd' },
        { text: '$ ks resume s_7f3a', tone: 'cmd' },
        { text: 'restored in 87s · nonce match ', tone: 'ok', mark: true, text2: '· 0 bytes lost' },
        { text: '[agent resumes mid-sentence]', tone: 'work' },
      ];
      const loop = async () => {
        while (alive) {
          lines = []; render();
          await wait(700);
          await type('$ ks run --image claude-code --workspace ./payments-migration', 'cmd');
          await wait(300);
          push({ text: 'session s_7f3a started · checkpointing every 5m', tone: 'dim' });
          await wait(420);
          let elapsed = 4 * 3600 + 58 * 60 + 12;
          push({ text: `[agent working · ${fmt(elapsed)} elapsed · 312 files touched]`, tone: 'work' });
          for (let i = 0; i < 22; i++) {
            if (!alive) return;
            await wait(110);
            elapsed += 1;
            patchLast({ text: `[agent working · ${fmt(elapsed)} elapsed · 312 files touched]` });
          }
          await wait(260);
          await type('$ kill -9 14203            # the plug, pulled', 'cmd');
          if (flashEl) { flashEl.style.opacity = '0.55'; await wait(90); flashEl.style.opacity = '0'; }
          await wait(620);
          await type('$ ks resume s_7f3a', 'cmd');
          await wait(520);
          push({ text: 'restored in 87s · nonce match ', tone: 'ok', mark: true, text2: '· 0 bytes lost' });
          await wait(340);
          push({ text: '[agent resumes mid-sentence]', tone: 'work' });
          await wait(4000);
        }
      };
      if (reduced) { lines = finalFrame(); render(); } else { loop(); }

      // Fork draw-in + econ count-up on scroll (the composite's observers).
      const econEl = document.getElementById('econ');
      const svg = document.getElementById('fork-svg');
      if (reduced) {
        document.querySelectorAll('.fork-path').forEach((p) => (p.style.strokeDashoffset = '0'));
        if (econEl) econEl.textContent = '−45%';
      } else {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            if (e.target === econEl) {
              const t0 = performance.now();
              const step = (now) => {
                const p = Math.min(1, (now - t0) / 700);
                econEl.textContent = '−' + Math.round((1 - Math.pow(1 - p, 3)) * 45) + '%';
                if (p < 1) requestAnimationFrame(step);
              };
              requestAnimationFrame(step);
            } else {
              document.querySelectorAll('.fork-path').forEach((p) => (p.style.strokeDashoffset = '0'));
            }
            io.unobserve(e.target);
          });
        }, { threshold: 0.4 });
        if (svg) io.observe(svg);
        if (econEl) io.observe(econEl);
      }
    </script>
  </body>
</html>
