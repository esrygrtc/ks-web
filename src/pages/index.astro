---
// The home page, built from design/KeepState.dc.html (the flagship).
// Copy carried verbatim (dedashed) is asserted by design/copy/index.txt.
// Law 2 note: the composite's demo numbers (-45%, 50-70%, restored in
// 87s) are illustrations and do not ship as facts; the evidence strip
// below carries only measured numbers from src/generated/proof.json.
import Site from '../layouts/Site.astro';
import Button from '../components/Button.astro';
import Terminal from '../components/Terminal.astro';
import DiamondTimeline from '../components/DiamondTimeline.astro';
import MetricCard from '../components/MetricCard.astro';
import Field from '../components/Field.astro';

const termLines: { text: string; tone: 'cmd' | 'dim' | 'work' | 'ok' }[] = [
  { text: '$ ks run --image claude-code --workspace ./payments-migration', tone: 'cmd' },
  { text: 'session s_7f3a started · checkpointing every 5m', tone: 'dim' },
  { text: '[agent working · 04:58:12 elapsed · 312 files touched]', tone: 'work' },
  { text: '$ kill -9 14203            # the plug, pulled', tone: 'cmd' },
  { text: '$ ks resume s_7f3a', tone: 'cmd' },
  { text: 'restored · nonce match', tone: 'ok' },
  { text: '[agent resumes mid-sentence]', tone: 'work' },
];
const tone = { cmd: 'text-paper', dim: 'text-termMuted', work: 'text-blush', ok: 'text-parchment' };

const checkpoints = [
  { id: 's_7f3a@10' },
  { id: 's_7f3a@20' },
  { id: 's_7f3a@30' },
  { id: 's_7f3a@40 (forked)', current: true, fork: true },
  { id: 's_7f3a@50' },
  { id: 's_7f3a@60' },
];
const steers = ['--steer "one big migration"', '--steer "keep legacy adapter"', '--steer "split by tenant"'];

const problems = [
  { head: 'Mid-task death', body: 'Sandbox crash, rate limit, provider blip. Everything gone. Restart from zero.' },
  { head: 'The replay tax', body: 'The same context, re-sent to the model step after step after step.' },
  { head: 'The duct-taped stack', body: 'Framework, sandbox, workflow engine, state store, per-vendor caches.' },
];

const pillars = [
  {
    href: '/product/sessions',
    name: 'Sessions',
    head: 'Three states. One freeze.',
    cmd: 'ks save s_7f3a',
    body: 'Filesystem + model memory + tool state. One atomic snapshot. Kill it anywhere. Resume anywhere. The world and the memory can never disagree.',
  },
  {
    href: '/product/fork',
    name: 'Fork',
    head: 'Branch step 40 into six universes. Keep the winner.',
    cmd: 'ks fork s_7f3a@40 -n 6',
    body: 'The API is stateless; each fork is just a conversation that went differently.',
  },
  {
    href: '/product/gateway-cost',
    name: 'Gateway & Cost',
    head: 'Never pay twice for an interrupted call.',
    cmd: 'ks run --image claude-code',
    body: 'Cache-aware routing across providers. Stored-response replay. Budget caps.',
  },
  {
    href: '/product/governance-replay',
    name: 'Governance & Replay',
    head: 'Re-execute what actually happened. Evidence, not logs.',
    cmd: 'ks replay s_7f3a',
    body: 'Deterministic replay from checkpointed state. Audit trails with sequence lineage.',
  },
];

const whyNow = [
  { head: 'Task horizons keep doubling', body: 'Agent task horizons keep doubling. Minutes became hours. Hours become days.' },
  { head: 'The dominant AI cost line', body: 'Inference-time compute now outweighs everything else in the agent economy.' },
  { head: 'Agents got hands', body: 'MCP standardized tools. Long tasks became the default, not the demo.' },
];
---
<Site
  title="KeepState · The durable agent session cloud"
  description="KeepState runs your AI agents inside snapshot-able micro-VMs. One API: run, checkpoint, fork, resume, replay. Any model, any harness."
  footer="marketing"
>
  <main>
    <!-- Hero -->
    <section class="max-w-[1180px] mx-auto px-7 pt-16 pb-14">
      <div class="grid gap-12 items-center lg:grid-cols-2">
        <div>
          <p class="font-mono text-11 uppercase tracking-[0.14em] text-claret mt-0 mb-4">The durable agent session cloud</p>
          <h1 class="font-serif text-34 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-5">Your agents never start over.</h1>
          <p class="text-16 leading-relaxed text-slate mt-0 mb-5 max-w-[46ch]">KeepState runs your AI agents inside snapshot-able micro-VMs. One API: run, checkpoint, fork, resume, replay. Any model, any harness.</p>
          <p class="font-serif italic text-17 text-ink leading-relaxed mt-0 mb-7 max-w-[42ch]">An agent that dies at hour five is a bill. An agent that resumes is an employee.</p>
          <div class="flex gap-3.5 flex-wrap">
            <Button href="/#partner" variant="primary">Start building</Button>
            <Button href="#demo" variant="secondary">Watch the plug get pulled</Button>
          </div>
        </div>
        <figure class="m-0" id="demo">
          <Terminal session="ks · live session">
            {termLines.map((l) => (
              <div class={tone[l.tone]}>{l.text}</div>
            ))}
          </Terminal>
          <figcaption class="font-mono text-11 text-taupe mt-2.5 flex items-center gap-1.5 flex-wrap">
            an illustration of the demo loop, not a measurement ·
            <a href="/proof#gate-4" class="inline-flex items-center gap-1.5 text-claret no-underline hover:underline">
              <span class="w-[6px] h-[6px] bg-claret rotate-45 inline-block"></span>the measured kill-and-resume
            </a>
          </figcaption>
        </figure>
      </div>
    </section>

    <!-- Session timeline: the rail of checkpoints, one forked three ways -->
    <section class="max-w-[1180px] mx-auto px-7 py-14">
      <h2 class="font-serif text-26 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-7 max-w-[22em]">Every checkpoint is a door to six futures.</h2>
      <div class="bg-white border border-sand rounded-5 p-6">
        <p class="font-mono text-11 text-claret mt-0 mb-1">step 40</p>
        <DiamondTimeline
          checkpoints={checkpoints}
          caption="one diamond per checkpoint · the filled one forked three ways"
        />
        <div class="grid gap-3 mt-5 sm:grid-cols-3">
          {steers.map((s) => (
            <div class="bg-ink rounded-4 px-3.5 py-3 font-mono text-11 text-blush overflow-x-auto whitespace-nowrap">{s}</div>
          ))}
        </div>
      </div>
      <p class="text-15 leading-relaxed text-slate mt-6 mb-4 max-w-[42em]">Fork a two-day-old freeze ten times. The API is stateless; each fork is just a conversation that went differently. Your bill is the only one who notices.</p>
      <p class="text-15 leading-relaxed text-slate mt-0 mb-0 max-w-[42em]">Claude Code's own resume is a quest log: your notes survive, the world resets. KeepState is a save state: the running tests, the dev server, the half-finished thought, frozen mid-frame and thawed intact.</p>
    </section>

    <!-- The problem -->
    <section class="bg-parchment border-y border-sand">
      <div class="max-w-[1180px] mx-auto px-7 py-14">
        <p class="font-mono text-11 uppercase tracking-[0.14em] text-claret mt-0 mb-2">The problem</p>
        <h2 class="font-serif text-26 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-8">Agents die mid-task. You pay twice.</h2>
        <div class="grid gap-4 md:grid-cols-3">
          {problems.map((p) => (
            <div class="bg-white border border-sand rounded-4 p-5">
              <p class="font-serif text-17 text-ink mt-0 mb-2">{p.head}</p>
              <p class="text-13 leading-relaxed text-slate m-0">{p.body}</p>
            </div>
          ))}
        </div>
        <p class="text-15 text-slate mt-7 mb-0 max-w-[42em]">Every serious agent team rebuilds this privately. None of them wants to.</p>
      </div>
    </section>

    <!-- The product pillars -->
    <section class="max-w-[1180px] mx-auto px-7 py-14">
      <p class="font-mono text-11 uppercase tracking-[0.14em] text-claret mt-0 mb-2">The product</p>
      <h2 class="font-serif text-26 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-2">One API. Autosave for AI agents.</h2>
      <p class="font-mono text-12 text-taupe mt-0 mb-8">run · checkpoint · fork · resume · replay</p>
      <div class="grid gap-4 sm:grid-cols-2">
        {pillars.map((p) => (
          <a href={p.href} class="block bg-white border border-sand rounded-5 p-5 no-underline hover:border-ink group">
            <p class="font-mono text-10 uppercase tracking-[0.12em] text-claret mt-0 mb-2.5 flex items-center gap-2">
              <span class="w-[6px] h-[6px] bg-claret rotate-45 block"></span>{p.name}
            </p>
            <p class="font-serif text-20 leading-snug text-ink mt-0 mb-2.5">{p.head}</p>
            <p class="font-mono text-11 text-parchment bg-ink rounded-3 px-2.5 py-1.5 inline-block mt-0 mb-3">$ {p.cmd}</p>
            <p class="text-13 leading-relaxed text-slate m-0">{p.body}</p>
            <p class="text-13 text-claret mt-3 mb-0 group-hover:underline">Read more →</p>
          </a>
        ))}
      </div>
    </section>

    <!-- The economics + evidence strip: real measured numbers only -->
    <section class="max-w-[1180px] mx-auto px-7 py-14">
      <h2 class="font-serif text-26 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-3 max-w-[22em]">The token bill drops the week you switch.</h2>
      <ul class="list-none p-0 mt-0 mb-8 grid gap-2 max-w-[42em]">
        <li class="text-14 text-slate flex items-baseline gap-2.5"><span class="w-[6px] h-[6px] bg-claret rotate-45 shrink-0 translate-y-[-1px]"></span>Cache-aware routing across providers.</li>
        <li class="text-14 text-slate flex items-baseline gap-2.5"><span class="w-[6px] h-[6px] bg-claret rotate-45 shrink-0 translate-y-[-1px]"></span>Stored-response replay: never pay twice for an interrupted call.</li>
        <li class="text-14 text-slate flex items-baseline gap-2.5"><span class="w-[6px] h-[6px] bg-claret rotate-45 shrink-0 translate-y-[-1px]"></span>Budget caps: ten forks can't detonate your card.</li>
      </ul>
      <p class="font-mono text-11 uppercase tracking-[0.14em] text-taupe mt-0 mb-3">Measured on the bench, not vibed</p>
      <div class="grid gap-4 md:grid-cols-3">
        <MetricCard
          label="Checkpoint dedup under sustained load"
          value="19.1x"
          badge="MEASURED"
          evidenceHref="/proof#gate-6"
          evidenceTag="gate-6-green"
          note="82 checkpoints: 4,233 MiB stored vs 80,952 MiB naive."
        />
        <MetricCard
          label="Fresh kill-and-resume cycles"
          value="25/25"
          badge="MEASURED"
          evidenceHref="/proof#gate-6"
          evidenceTag="gate-6-green"
          note="Wilson 95% CI [86.7%, 100.0%]. Durability is a rate, not an anecdote."
        />
        <MetricCard
          label="Resume after a hard kill"
          value="25.2"
          unit=" s"
          badge="MEASURED"
          evidenceHref="/proof#gate-4"
          evidenceTag="gate-4-green"
          note="Measured downtime, agent and daemon killed together. A ~14.5 h-old checkpoint woke in 14.3 s."
        />
      </div>
    </section>

    <!-- Why now -->
    <section id="why-now" class="bg-blushBg border-y border-sand scroll-mt-24">
      <div class="max-w-[1180px] mx-auto px-7 py-14">
        <p class="font-mono text-11 uppercase tracking-[0.14em] text-claret mt-0 mb-2">Why now</p>
        <h2 class="font-serif text-26 leading-[1.08] tracking-[-0.02em] font-normal mt-0 mb-8">Counting the OOMs of agent-hours.</h2>
        <div class="grid gap-4 md:grid-cols-3">
          {whyNow.map((w) => (
            <div class="bg-white border border-sand rounded-4 p-5">
              <p class="font-serif text-17 text-ink mt-0 mb-2">{w.head}</p>
              <p class="text-13 leading-relaxed text-slate m-0">{w.body}</p>
            </div>
          ))}
        </div>
        <p class="text-15 text-slate mt-7 mb-12 max-w-[42em]">What the 2024 forecasts called unhobbling is now a workload. Its substrate is unowned.</p>
        <div class="max-w-[62ch] mx-auto text-center">
          <span class="w-2.5 h-2.5 bg-claret rotate-45 inline-block mb-6"></span>
          <p class="font-serif text-26 leading-[1.16] tracking-[-0.02em] mt-0 mb-6">fal taxes generative media. KeepState taxes agent-hours.</p>
          <p class="text-16 leading-relaxed text-slate text-left mt-0 mb-6">Every long-running task in the world is becoming a session: metered, durable, forkable, replayable. We are building the layer that keeps that state, the way the caravanserai kept the caravans: the place where long journeys checkpoint for the night and continue at dawn. The open session protocol is named han in its honor.</p>
          <a href="/manifesto" class="text-15 font-medium text-claret no-underline hover:underline">Read the manifesto: The Session Economy →</a>
        </div>
      </div>
    </section>

    <!-- Design partner intake -->
    <section id="partner" class="bg-ink scroll-mt-24">
      <div class="max-w-[1180px] mx-auto px-7 py-16">
        <div class="grid gap-12 items-start lg:grid-cols-2">
          <div>
            <h2 class="font-serif text-34 leading-[1.08] tracking-[-0.02em] font-normal text-paper mt-0 mb-5">Send us one trace of your longest run.</h2>
            <p class="text-16 leading-relaxed text-parchment mt-0 mb-8 max-w-[46ch]">Within two weeks we <span class="text-blush">pull the plug on your agent, live,</span> and hand you the cost model of what you'd save.</p>
            <p class="font-mono text-11 tracking-[0.1em] text-termMuted m-0">keepstate.ai · the durable agent session cloud</p>
          </div>
          <form method="post" action="/api/partner" class="bg-paper border border-sand rounded-5 p-6 grid gap-4">
            <p class="font-mono text-10 uppercase tracking-[0.12em] text-claret m-0 flex items-center gap-2">
              <span class="w-[6px] h-[6px] bg-claret rotate-45 block"></span>Design partner intake
            </p>
            <Field label="Name" name="name" placeholder="Ada Lovelace" />
            <Field label="Work email" name="email" type="email" placeholder="you@company.com" />
            <Field label="Company" name="company" placeholder="Acme Agents, Inc." />
            <Field label="What agent do you run" name="agent" placeholder="Claude Code, aider, a custom harness" help="Name the harness and roughly how long your longest runs go." />
            <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
            <div>
              <Button type="submit" variant="primary">Become a design partner</Button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </main>
</Site>
