---
// The 500, 1:1 from design/Auth & System States.dc.html (the is500
// screen). Carve-out (a): the composite's sample error reference
// (err_5b2f109c, a timestamp, "already filed") is live incident data a
// static page cannot know; the reference card keeps the exact mono-card
// layout but renders its honest unavailable state instead.
import Site from '../layouts/Site.astro';
---
<Site
  title="500 · KeepState"
  description="Our fault, and our ledger saw it. Sessions and checkpoints are not affected by this page failing."
  footer="console"
  noindex
>
  <main class="max-w-[1240px] mx-auto px-[26px] w-full">
    <div class="flex items-center min-h-[78vh] py-[60px]">
      <div class="max-w-[34em]">
        <p class="font-mono text-[clamp(48px,8vw,78px)] leading-none text-claret tracking-[-0.04em] m-0 mb-6" aria-hidden="true">500</p>
        <h1 class="font-serif text-[clamp(30px,4.2vw,44px)] leading-[1.1] tracking-[-0.022em] font-normal m-0 mb-[18px]">Our fault, and our ledger saw it.</h1>
        <p class="text-16 leading-[1.7] text-slate m-0 mb-[22px]">Your sessions and checkpoints are not affected by this page failing. The status page is the source of truth for what is actually degraded.</p>
        <div class="bg-white border border-sand rounded-4 px-[17px] py-[15px] mb-7">
          <p class="font-mono text-12 text-taupe m-0">ref unavailable on a static page · the incident, if there is one, is filed on our side</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <a href="/status" class="text-15 font-medium text-paper bg-claret rounded-3 px-[22px] py-[13px] no-underline hover:no-underline hover:text-paper">Status page</a>
          <a href="/console" class="text-15 font-medium text-ink border border-sand rounded-3 px-[21px] py-3 no-underline hover:no-underline hover:text-ink">Back to console</a>
        </div>
      </div>
    </div>
  </main>
</Site>
