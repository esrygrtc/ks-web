---
// The 500, from design/Auth & System States.dc.html (the is500 screen).
// The composite's sample error reference (err_5b2f109c, a timestamp) is
// illustration data; a static page cannot know a real reference, so that
// block renders its honest unavailable equivalent instead (UI Law 1).
import Site from '../layouts/Site.astro';
import Button from '../components/Button.astro';
---
<Site
  title="500 · KeepState"
  description="Our fault, and our ledger saw it. Sessions and checkpoints are not affected by this page failing."
  footer="console"
  noindex
>
  <main class="max-w-[1180px] mx-auto px-7">
    <div class="flex items-center min-h-[70vh] py-16">
      <div class="max-w-[34em]">
        <p class="font-mono text-34 leading-none text-claret tracking-[-0.04em] mt-0 mb-6" aria-hidden="true">500</p>
        <h1 class="font-serif text-34 leading-[1.1] tracking-[-0.022em] font-normal mt-0 mb-4">Our fault, and our ledger saw it.</h1>
        <p class="text-16 leading-relaxed text-slate mt-0 mb-5">Your sessions and checkpoints are not affected by this page failing. The status page is the source of truth for what is actually degraded.</p>
        <div class="bg-white border border-sand rounded-4 px-4 py-3.5 mb-7">
          <p class="font-mono text-12 text-taupe m-0">error reference unavailable on a static page · the incident, if there is one, is filed on our side</p>
        </div>
        <div class="flex gap-3 flex-wrap">
          <Button href="/status">Status page</Button>
          <Button href="/console" variant="secondary">Back to console</Button>
        </div>
      </div>
    </div>
  </main>
</Site>
