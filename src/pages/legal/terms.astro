---
// Terms of Service: body carried verbatim from the Legal & Support
// composite, except one clause claiming billing-incident history that
// has not happened (nothing has launched); that clause is cut.
import Legal from './_Legal.astro';

const standfirst = 'The agreement between your organization and KeepState, Inc. for use of the durable agent session cloud. Written to be read once by a person rather than skimmed by a lawyer.';
const plain = 'You keep ownership of everything your agents produce. We run the infrastructure, meter it honestly, and can suspend an account for non-payment or abuse with notice. Neither side promises the other unlimited liability, and either side can leave with your data intact.';

const sections = [
  { n: '1', head: 'What we provide', paras: [
    'KeepState hosts agent sessions in isolated micro-VMs, checkpoints their state, and brokers model calls through a metering gateway. Availability commitments for each surface are stated in the service level agreement and measured by an external probe rather than by our own reporting.',
    'We may change how the service works, including adding, altering, or removing features. Material reductions in functionality are announced 30 days ahead in the changelog and by email to account Owners.',
  ] },
  { n: '2', head: 'Your content and your agents', paras: [
    'Everything your agents read, write, or produce belongs to you. This includes workspace contents, checkpoints, event ledgers, and any artifact a session generates. We claim no license to it beyond what is technically required to run, store, and restore the sessions you asked us to run.',
  ], list: [
    'We do not train models on your content, and we do not permit our subprocessors to.',
    'We do not read your checkpoints except through a break-glass path that notifies your Owners and writes to your audit log.',
    'You may export your ledgers and checkpoint manifests at any time, on any plan, including the free tier.',
  ] },
  { n: '3', head: 'Acceptable use, in summary', paras: [
    'The full list lives in the acceptable use policy. In short: do not use sessions to attack others, to host abuse infrastructure, to mine cryptocurrency, or to run workloads whose purpose is to circumvent a model provider’s own terms. An agent acting on your instructions is your responsibility.',
  ] },
  { n: '4', head: 'Fees, meters, and disputes', paras: [
    'You pay for session-minutes, checkpoint storage after deduplication, and, if you use our inference, a spread on brokered tokens. Meter output is authoritative for billing, and your ledgers show the same figures we bill from, line by line.',
    'If you believe a charge is wrong, tell us within 60 days and we will reconcile it against the ledger. Where our meter is at fault we credit the difference.',
  ] },
  { n: '5', head: 'Suspension and termination', paras: [
    'Either side may terminate for convenience with 30 days notice. We may suspend immediately for non-payment after two written reminders, or without notice where a workload is actively harming others or our infrastructure.',
  ], list: [
    'On termination your checkpoints remain retrievable for 30 days, then are destroyed.',
    'Checkpoints under a legal hold survive termination until the hold is lifted, and you will be told which ones.',
    'Prepaid unused credits are refunded pro rata unless termination was for abuse.',
  ] },
  { n: '6', head: 'Warranties and liability', paras: [
    'We provide the service with reasonable skill and care and make the specific commitments in the SLA. Beyond those, the service is provided as it is: we do not warrant that an agent will behave correctly, that a model will return useful output, or that a workload will succeed.',
    'Each side’s aggregate liability is capped at the fees paid in the preceding 12 months, except for death or personal injury caused by negligence, fraud, or a breach of confidentiality obligations, where no cap applies. Neither side is liable for indirect or consequential loss.',
  ] },
  { n: '7', head: 'Governing law', paras: [
    'These terms are governed by the laws of England and Wales, and the courts of London have exclusive jurisdiction. Enterprise agreements may vary this and frequently do.',
  ], note: 'Governing law, the SLA, and entity details are drafted and under founder legal review; nothing here is effective until launch.' },
];
---
<Legal
  title="Terms of Service · KeepState"
  description="The draft agreement for use of the KeepState durable agent session cloud: ownership, metering, suspension, liability. Effective upon launch."
  docTitle="Terms of Service"
  standfirst={standfirst}
  plain={plain}
  sections={sections}
/>
