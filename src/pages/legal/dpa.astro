---
// Data Processing Agreement: body carried verbatim from the Legal &
// Support composite (fidelity ruling 2026-08-20: the design is the
// spec, including its version chip, dates, and depicted machinery).
import Legal from './_Legal.astro';

const standfirst = 'Where session contents are personal data, you are the controller and we are the processor. This document is the instruction set, and it is the one your reviewer will actually read.';
const plain = 'We process session contents only to run the sessions you asked for. We use approved subprocessors, keep data in the region you pinned, notify you of a breach within 24 hours, and delete or return everything on termination.';

const sections = [
  { n: '1', head: 'Roles and scope', paras: [
    'You determine what your agents do and what data they touch, which makes you the controller. We host, checkpoint, and restore, which makes us the processor. Our instructions come from your use of the product: a checkpoint happens because you set a cadence, not because we decided to keep a copy.',
  ] },
  { n: '2', head: 'Processing instructions', paras: [
    'We process session contents for exactly four purposes and no others.',
  ], list: [
    'Running the session: executing the workload inside the micro-VM you requested.',
    'Durability: writing, storing, and restoring checkpoints under your retention policy.',
    'Metering: counting session-minutes, storage after dedup, and tokens brokered through the gateway.',
    'Support: only when you open a ticket and only through the break-glass path, which notifies your Owners and writes to your audit log.',
  ] },
  { n: '3', head: 'Security measures', paras: [
    'Technical measures are described in full in the architecture overview. The load-bearing ones: hardware-virtualized single-tenant guests, encryption at rest with per-organization keys, provider credentials held outside the isolation boundary, and credential scanning on checkpoint write.',
    'Organizational measures: least-privilege access, mandatory review for production changes, an audit trail of every staff action against customer data, and annual security training that is not a slideshow.',
  ] },
  { n: '4', head: 'Subprocessors', paras: [
    'The current list is published and versioned. We remain liable for our subprocessors’ processing. You get 30 days notice before we add one that handles session contents, and if you object on reasonable grounds you may terminate the affected service without penalty.',
  ] },
  { n: '5', head: 'Breach notification', paras: [
    'We notify you within 24 hours of becoming aware of a personal data breach affecting your session contents, with what we know at that point rather than waiting for a complete picture. Subsequent updates follow as the investigation proceeds, and the write-up is published in the findings archive once affected customers have been told.',
  ] },
  { n: '6', head: 'International transfers', paras: [
    'Where a transfer outside the UK or EEA is necessary, it relies on the UK International Data Transfer Addendum or the EU Standard Contractual Clauses, with a transfer impact assessment available on request. Region pinning avoids the question entirely for most customers, and we recommend it.',
  ] },
  { n: '7', head: 'Deletion and return', paras: [
    'On termination you may export everything through the API. After 30 days we delete session contents, including from backups within a further 30 days. Checkpoints under legal hold are the exception and are itemized to you rather than silently retained.',
  ] },
  { n: '8', head: 'Audits', paras: [
    'You may audit our compliance once a year, or more often after a breach affecting you. In practice most reviewers accept the security review pack, the penetration test summary, and the public findings archive, which is why all three exist without a form in front of them.',
  ] },
];
---
<Legal
  title="Data Processing Agreement · KeepState"
  description="The DPA: controller and processor roles, the four processing purposes, breach notification, transfers, deletion."
  docTitle="Data Processing Agreement"
  version="v4.1"
  effective="2026-06-01"
  length="about 11 minutes"
  standfirst={standfirst}
  plain={plain}
  sections={sections}
  toc={['Roles and scope', 'Processing instructions', 'Security measures', 'Subprocessors', 'Breach notification', 'International transfers', 'Deletion and return', 'Audits']}
/>
