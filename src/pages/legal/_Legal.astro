---
// Shared frame for the five legal documents (underscore = unrouted),
// mirrored 1:1 from design/Legal & Support.dc.html: a 244px document
// mini-nav on a hairline, a 72ch serif document with version chip and
// numbered sections, and a 212px "On this page" rail. The composite's
// doc-switcher buttons become real routes; everything else keeps its
// exact inline geometry.
import Site from '../../layouts/Site.astro';

interface Section {
  n: string;
  head: string;
  paras: string[];
  list?: string[];
  table?: { head: string[]; rows: string[][] };
}
interface Props {
  title: string;
  description: string;
  docTitle: string;
  version: string;
  effective: string;
  length: string;
  standfirst: string;
  plain: string;
  sections: Section[];
  toc: string[];
}
const { title, description, docTitle, version, effective, length, standfirst, plain, sections, toc } = Astro.props;

const nav = [
  ['Terms of Service', '/legal/terms'],
  ['Privacy Policy', '/legal/privacy'],
  ['Data Processing Agreement', '/legal/dpa'],
  ['Subprocessors', '/legal/subprocessors'],
  ['Acceptable Use', '/legal/acceptable-use'],
];
const path = Astro.url.pathname.replace(/\/$/, '');
---
<Site title={title} description={description} noindex>
  <div class="flex items-stretch flex-1 min-h-0">

    <nav aria-label="legal documents"
      class="w-[244px] flex-none border-r border-sand pt-7 px-3.5 pb-[60px] hidden min-[820px]:flex flex-col gap-[3px] sticky top-[61px] self-start max-h-[calc(100vh-61px)] overflow-y-auto">
      <p class="font-mono text-10 tracking-[0.12em] uppercase text-taupe m-0 mb-3 px-2.5">Documents</p>
      {nav.map(([label, href]) => (
        <a href={href} aria-current={path === href ? 'page' : undefined}
          class={`w-full flex items-center gap-[9px] font-sans text-13 rounded-3 px-2.5 py-[9px] min-h-[38px] text-left no-underline hover:no-underline ${path === href ? 'text-ink bg-parchment font-semibold' : 'text-slate font-normal hover:text-ink'}`}>
          <span class={`w-[5px] h-[5px] rotate-45 block flex-none ${path === href ? 'bg-claret' : 'bg-white/0'}`}></span>{label}
        </a>
      ))}
      <div class="border-t border-sand mt-4 mb-3"></div>
      <p class="font-mono text-[10.5px] leading-[1.7] text-taupe m-0 px-2.5">All five documents download together in the <a href="/enterprise" class="text-claret no-underline hover:text-ink hover:underline underline-offset-[3px]">security review pack</a>, with no form.</p>
    </nav>

    <main class="flex-1 min-w-0 pt-[30px] px-8 pb-20">
      <div class="max-w-[72ch]">
        <nav class="flex items-center gap-2 flex-wrap text-12 text-taupe mb-5" aria-label="breadcrumb">
          <span>Legal</span><span>/</span><span class="text-ink">{docTitle}</span>
        </nav>

        <div class="flex items-center gap-3 flex-wrap mb-[18px]">
          <span class="font-mono text-10 tracking-[0.1em] uppercase text-claret border border-shell bg-blushBg rounded-3 px-[9px] py-1">{version}</span>
          <span class="font-mono text-[11.5px] text-taupe">effective {effective} · {length}</span>
        </div>

        <h1 class="font-serif text-[clamp(32px,4.4vw,46px)] leading-[1.06] tracking-[-0.024em] font-normal m-0 mb-5">{docTitle}</h1>
        <p class="text-17 leading-[1.75] text-slate m-0 mb-[26px] [text-wrap:pretty]">{standfirst}</p>

        <div class="bg-parchment border border-sand rounded-5 px-6 py-[22px] mb-10">
          <div class="flex items-center gap-[9px] mb-3">
            <span class="w-1.5 h-1.5 bg-claret rotate-45 block"></span>
            <span class="font-mono text-10 tracking-[0.1em] uppercase text-claret">the short version</span>
          </div>
          <p class="text-[15.5px] leading-[1.72] text-ink m-0">{plain}</p>
          <p class="text-[12.5px] leading-[1.6] text-taupe mt-3 mb-0">A summary is not the agreement. Where the two disagree, the clauses below govern.</p>
        </div>

        {sections.map((sec) => (
          <section class="mb-[34px]">
            <div class="flex items-baseline gap-3 mb-3.5">
              <span class="font-mono text-12 text-claret flex-none">{sec.n}</span>
              <h2 class="font-serif text-[25px] leading-[1.2] font-medium m-0">{sec.head}</h2>
            </div>
            {sec.paras.map((p) => (
              <p class="text-16 leading-[1.78] text-slate mt-0 mb-4">{p}</p>
            ))}
            {sec.list && (
              <div class="grid gap-0 mt-1.5 mb-4">
                {sec.list.map((li) => (
                  <div class="flex gap-3 items-start py-[11px] border-t border-track">
                    <span class="w-[5px] h-[5px] bg-stone rotate-45 block mt-2 flex-none"></span>
                    <p class="text-[15.5px] leading-[1.7] text-slate m-0">{li}</p>
                  </div>
                ))}
              </div>
            )}
            {sec.table && (
              <div class="bg-white border border-sand rounded-5 overflow-hidden mt-1.5 mb-4">
                <div class="overflow-x-auto">
                  <table class="w-full border-collapse text-13 min-w-[460px]">
                    <thead>
                      <tr class="bg-paper">
                        {sec.table.head.map((h) => (
                          <th class="text-left text-10 font-semibold tracking-[0.1em] uppercase text-taupe px-4 py-[11px] border-b border-sand">{h}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {sec.table.rows.map((r) => (
                        <tr class="border-b border-track">
                          {r.map((cell, i) => (
                            i === 0
                              ? <td class="px-4 py-3 text-[13.5px] text-ink">{cell}</td>
                              : <td class="px-4 py-3 font-mono text-12 text-slate">{cell}</td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>
            )}
          </section>
        ))}

        <div class="border-t border-sand pt-6 flex items-center justify-between gap-[18px] flex-wrap">
          <p class="text-[13.5px] leading-[1.65] text-taupe m-0 max-w-[36em]">Material changes are announced 30 days before they take effect, by email to Owners and in the <a href="/changelog" class="text-claret no-underline hover:text-ink hover:underline underline-offset-[3px]">changelog</a>. Previous versions stay published.</p>
          <div class="flex gap-2.5 flex-wrap">
            <button type="button" class="font-sans text-13 font-medium text-ink bg-white border border-sand rounded-3 px-[15px] py-2.5 cursor-pointer">Download PDF</button>
            <button type="button" class="font-sans text-13 font-medium text-ink bg-white border border-sand rounded-3 px-[15px] py-2.5 cursor-pointer">Version history</button>
          </div>
        </div>
      </div>
    </main>

    <aside aria-label="on this page"
      class="w-[212px] flex-none pt-[30px] px-6 pb-[60px] hidden min-[1080px]:flex flex-col gap-[9px] sticky top-[61px] self-start max-h-[calc(100vh-61px)] overflow-y-auto">
      <p class="font-mono text-10 tracking-[0.12em] uppercase text-taupe m-0 mb-1">On this page</p>
      {toc.map((label, i) => (
        <span class={`text-[12.5px] leading-[1.5] py-[3px] pl-[11px] border-l-2 ${i === 0 ? 'text-ink border-claret' : 'text-taupe border-disabledBd'}`}>{label}</span>
      ))}
    </aside>
  </div>
</Site>
