---
import Footer from '../components/Footer.astro';
// The pricing page, 1:1 from design/Pricing.dc.html. This page carries
// its OWN header and ends at the #partner band because the composite
// does; every section, color, size, and behavior below mirrors the
// composite's inline styles and DCLogic. Tiers, meter rates, quotas and
// FAQ terms are rendered VERBATIM from the composite (fidelity ruling,
// 2026-08-20: the design is the spec, numbers included). The calculator
// keeps its working mechanics inside that shell: server-rendered
// defaults, inline vanilla script, ESTIMATED badging (UI Law 2), and a
// NaN-proof unavailable state (UI Law 1: invalid input renders the
// unavailable chip, never 0 or NaN).
import '../styles/fonts.css';
const title = 'Pricing · KeepState';
const description = 'Three meters, one bill: session-minutes while a VM is awake, checkpoint storage after dedup, and managed tokens only if you use our inference.';
const canonical = new URL('/pricing/', Astro.site);

const tiers = [
  {
    name: 'Free', price: 'One real plug-pull', sub: 'On us, no card.',
    rows: ['Trial credits for a full six-hour run', '24-hour checkpoint retention', 'Community support', 'Gateway-only mode available'],
    cta: 'Start free',
    card: 'bg-white border-sand', dot: 'bg-stone', eyebrow: 'text-taupe',
    price_c: 'text-ink', sub_c: 'text-slate', body_c: 'text-slate',
    cta_c: 'text-ink bg-white border-sand',
  },
  {
    name: 'Developer', price: '$29 / mo', sub: 'Plus usage on three meters.',
    rows: ['30-day checkpoint retention', 'Unlimited forks and replays', 'Personal budgets and caps', 'Email support'],
    cta: 'Start building',
    card: 'bg-white border-sand', dot: 'bg-stone', eyebrow: 'text-taupe',
    price_c: 'text-ink', sub_c: 'text-slate', body_c: 'text-slate',
    cta_c: 'text-ink bg-white border-sand',
  },
  {
    name: 'Team', price: '$49 / seat / mo', sub: 'Plus usage. Shared everything.',
    rows: ['Shared budgets and org caps', 'Fleet view of parked agents', 'Roles and audit log', '90-day checkpoint retention'],
    cta: 'Start a team',
    card: 'bg-blushBg border-shell', dot: 'bg-claret', eyebrow: 'text-claret',
    price_c: 'text-ink', sub_c: 'text-slate', body_c: 'text-slate',
    cta_c: 'text-paper bg-claret border-claret',
  },
  {
    name: 'Enterprise', price: 'Talk to us', sub: 'Procurement, not a checkout.',
    rows: ['SSO and SCIM', 'Sovereign regions', 'Replay retention in years', 'Security review pack, one download'],
    cta: 'Contact sales',
    card: 'bg-slate border-slate', dot: 'bg-blush', eyebrow: 'text-blush',
    price_c: 'text-paper', sub_c: 'text-slateSoft', body_c: 'text-slateSoft',
    cta_c: 'text-ink bg-paper border-paper',
  },
];

const meters = [
  {
    name: 'Session-minutes', rate: '$0.011 / min · vm.large',
    body: 'Billed while a VM is awake, by the second, at the size you asked for. A parked session bills none of this.',
    note: 'vm.small 0.004 · vm.large 0.011 · vm.xl 0.024',
  },
  {
    name: 'Checkpoint storage', rate: '$0.09 / GB-month',
    body: 'Measured after deduplication, not before. Content-addressed dedup measured at 19x on our own soak.',
    note: 'a 1.2 GB freeze taken every 5m adds about 41 MB',
  },
  {
    name: 'Managed tokens', rate: '4% spread',
    body: 'Only if you use our inference. Bring your own keys and this meter does not appear on your bill; we meter durability only.',
    note: 'BYOK keys never enter a guest, an image, or a snapshot',
  },
];

const faqs = [
  { q: 'What happens when a budget cap is reached?', a: 'The session checkpoints, then parks. Nothing is killed and nothing is lost. Raise the cap and it wakes from the freeze it took on the way down. We do not silently kill work you paid to produce.' },
  { q: 'How do budgets work across forks?', a: 'A cap set on a parent applies to the whole lineage. Ten forks of a two-day-old freeze draw on one pool, so a fan-out cannot detonate your card. Each fork also carries its own optional sub-cap.' },
  { q: 'Do credits expire?', a: 'Trial credits expire 60 days after signup. Purchased credits do not expire while the account is active. Unused purchased credits are refundable pro rata within the first 30 days.' },
  { q: 'What do I pay for a parked session?', a: 'Storage only. A parked agent is a document: its checkpoints occupy deduplicated space and nothing else. Waking it costs session-minutes again from the moment it resumes.' },
  { q: 'Do I pay twice for an interrupted model call?', a: 'No. An interrupted call is stored and replayed from the store on retry. That row appears in your ledger as replayed with zero new tokens, and the gateway enforces it rather than trusting the client.' },
];

// Server-rendered defaults use the composite DCLogic's exact formula,
// so the no-JS page shows the same estimate the script would.
const s = { agents: 12, hours: 8, cadence: 5 };
const days = 30, vmRate = 0.011, gbMonth = 0.09;
const hoursMonth = s.agents * s.hours * days;
const compute = hoursMonth * 60 * vmRate;
const ckptsPerAgent = (s.hours * 60 / s.cadence) * days;
const gb = s.agents * Math.max(1.2, (ckptsPerAgent * 0.041) / 19);
const storage = gb * gbMonth;
const tokens = hoursMonth * 1.9;
const total = compute + storage + tokens;
const notRepurchased = hoursMonth * 2.4;
const money = (n: number) => '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 });
const unavailChip = 'hidden items-center gap-[7px] font-mono text-12 text-slate bg-parchment border border-sand rounded-3 px-2.5 py-1.5';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="preload" href="/fonts/Newsreader-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <!-- leading-[normal]: the composite sets no line-height anywhere above
       its inline styles, so every unstyled element inherits `normal`;
       preflight's 1.5 would swell each line box a few px. -->
  <body class="bg-paper text-ink font-sans leading-[normal] min-h-screen antialiased">

    <header class="sticky top-0 z-50 bg-paper/[0.94] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-4 flex items-center justify-between gap-6 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline hover:no-underline hover:text-ink">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
          <span class="font-serif text-[21px] leading-[normal] font-medium">KeepState</span>
        </a>
        <div class="flex items-center gap-[26px] flex-wrap">
          <a href="/" class="text-14 leading-[normal] text-slate no-underline hover:underline hover:text-slate underline-offset-[3px]">Product</a>
          <a href="/pricing" class="text-14 leading-[normal] text-ink font-medium no-underline hover:underline hover:text-ink underline-offset-[3px]">Pricing</a>
          <a href="/proof" class="text-14 leading-[normal] text-slate no-underline hover:underline hover:text-slate underline-offset-[3px]">Proof</a>
          <a href="/enterprise" class="text-14 leading-[normal] text-slate no-underline hover:underline hover:text-slate underline-offset-[3px]">Enterprise</a>
          <a href="/manifesto" class="text-14 leading-[normal] text-slate no-underline hover:underline hover:text-slate underline-offset-[3px]">Manifesto</a>
          <a href="#partner" class="text-14 leading-[normal] font-medium text-paper bg-claret px-4 py-[9px] rounded-3 no-underline hover:no-underline hover:text-paper">Start building</a>
        </div>
      </nav>
    </header>

    <!-- hero -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[72px] pb-12">
      <div class="flex items-center gap-[9px] mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 leading-[normal] font-semibold tracking-[0.16em] uppercase text-claret">Pricing</span>
      </div>
      <h1 class="font-serif text-[clamp(40px,5.6vw,64px)] leading-[1.04] tracking-[-0.025em] font-normal m-0 mb-6 max-w-[14em]">Three meters, one bill.</h1>
      <p class="text-17 leading-[1.7] text-slate m-0 max-w-[42em] [text-wrap:pretty]">You pay for the minutes a VM is awake, the storage its checkpoints occupy after dedup, and, if you use ours, the tokens we broker. Nothing else. Bring your own provider keys and the third meter disappears.</p>
    </section>

    <!-- tier cards -->
    <section class="max-w-[1180px] mx-auto px-7">
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,250px),1fr))] gap-[18px]">
        {tiers.map((t) => (
          <article class={`border rounded-5 py-[26px] px-6 flex flex-col gap-4 ${t.card}`}>
            <div>
              <div class="flex items-center gap-[9px] mb-3">
                <span class={`w-[7px] h-[7px] rotate-45 block ${t.dot}`}></span>
                <p class={`font-mono text-11 leading-[normal] tracking-[0.1em] uppercase m-0 ${t.eyebrow}`}>{t.name}</p>
              </div>
              <p class={`font-serif text-[30px] leading-[1.1] m-0 mb-2 ${t.price_c}`}>{t.price}</p>
              <p class={`text-13 leading-[1.55] m-0 ${t.sub_c}`}>{t.sub}</p>
            </div>
            <div class="grid gap-[9px] flex-1">
              {t.rows.map((r) => (
                <div class="flex gap-2.5 items-start">
                  <span class={`w-[5px] h-[5px] rotate-45 block mt-1.5 flex-none ${t.dot}`}></span>
                  <p class={`text-13 leading-[1.55] m-0 ${t.body_c}`}>{r}</p>
                </div>
              ))}
            </div>
            <a href="#partner" class={`text-14 leading-[normal] font-medium border rounded-3 py-[11px] px-4 text-center no-underline ${t.cta_c}`}>{t.cta}</a>
          </article>
        ))}
      </div>
    </section>

    <!-- the three meters -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[76px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3">The three meters, in plain rows.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-8 max-w-[40em]">Usage rates are the same on every paid tier. Volume commitments move them; nothing else does.</p>
      <div class="bg-white border border-sand rounded-5 overflow-hidden">
        {meters.map((m) => (
          <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,230px),1fr))] gap-y-2.5 gap-x-7 py-[22px] px-6 border-b border-track items-start">
            <div class="flex gap-[11px] items-start">
              <span class="w-[7px] h-[7px] bg-claret rotate-45 block mt-1.5 flex-none"></span>
              <div>
                <p class="text-15 leading-[normal] font-semibold m-0 mb-1">{m.name}</p>
                <p class="font-mono text-12 leading-[normal] text-claret m-0">{m.rate}</p>
              </div>
            </div>
            <p class="text-14 leading-[1.65] text-slate m-0">{m.body}</p>
            <p class="font-mono text-11 leading-[1.6] text-taupe m-0">{m.note}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- calculator -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[76px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-3">What it would cost you.</h2>
      <p class="text-15 leading-[1.65] text-slate m-0 mb-[30px] max-w-[40em]">Move the sliders. Everything this produces is an estimate, and it says so, because we have not measured your workload.</p>

      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-5 items-start">
        <div class="bg-white border border-sand rounded-5 py-[26px] px-6">
          <div class="grid gap-[26px]">
            <div>
              <div class="flex items-baseline justify-between gap-3 mb-3">
                <label for="pc-agents" class="text-13 leading-[normal] font-medium text-ink">Concurrent agents</label>
                <span id="pc-agents-val" class="font-mono text-14 leading-[normal] text-claret tabular-nums">{s.agents}</span>
              </div>
              <input id="pc-agents" type="range" min="1" max="200" step="1" value={s.agents} />
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3 mb-3">
                <label for="pc-hours" class="text-13 leading-[normal] font-medium text-ink">Hours per agent per day</label>
                <span id="pc-hours-val" class="font-mono text-14 leading-[normal] text-claret tabular-nums">{s.hours}</span>
              </div>
              <input id="pc-hours" type="range" min="1" max="24" step="1" value={s.hours} />
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3 mb-3">
                <label for="pc-cad" class="text-13 leading-[normal] font-medium text-ink">Checkpoint cadence</label>
                <span id="pc-cad-val" class="font-mono text-14 leading-[normal] text-claret">every {s.cadence}m</span>
              </div>
              <input id="pc-cad" type="range" min="1" max="60" step="1" value={s.cadence} />
              <p class="font-mono text-11 leading-[normal] text-taupe mt-2.5 mb-0">dedup measured at 19x, so cadence costs less than it reads</p>
            </div>
            <div>
              <p class="text-13 leading-[normal] font-medium text-ink mt-0 mb-3">Inference</p>
              <div class="flex gap-1 bg-parchment rounded-3 p-[3px] w-fit">
                <button type="button" id="pc-managed" class="font-sans text-12 leading-[normal] font-medium bg-ink text-paper border-0 rounded-2 py-2 px-3.5 cursor-pointer">Managed</button>
                <button type="button" id="pc-byok" class="font-sans text-12 leading-[normal] font-medium text-slate border-0 rounded-2 py-2 px-3.5 cursor-pointer">BYOK</button>
              </div>
              <p id="pc-keynote" class="text-12 leading-[1.55] text-taupe mt-3 mb-0">We broker inference at a 4 percent spread, with cache-aware routing and stored-response replay included.</p>
            </div>
          </div>
        </div>

        <div class="bg-ink rounded-5 py-7 px-[26px]">
          <div class="flex items-center justify-between gap-3 mb-[22px] flex-wrap">
            <p class="font-mono text-10 leading-[normal] tracking-[0.12em] uppercase text-termMuted m-0">monthly, all meters</p>
            <span class="font-mono text-9 leading-[normal] tracking-[0.12em] text-blush border border-inkLine rounded-2 py-0.5 px-1.5">ESTIMATED</span>
          </div>
          <p class="font-mono text-[clamp(38px,6vw,56px)] leading-none text-paper tracking-[-0.03em] tabular-nums mt-0 mb-1.5">
            <span id="pc-total" data-pc-value>{money(total)}</span>
            <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable (invalid input)</span>
          </p>
          <p class="font-mono text-12 leading-[normal] text-termMuted mt-0 mb-[26px]">
            <span id="pc-subtitle" data-pc-value>{hoursMonth.toLocaleString('en-US')} agent-hours per month</span>
            <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable</span>
          </p>
          <div class="grid gap-0">
            <div class="flex items-baseline justify-between gap-3.5 py-[13px] border-t border-inkBorder">
              <span class="font-mono text-12 leading-[normal] text-termMuted">session-minutes</span>
              <span class="font-mono text-13 leading-[normal] text-parchment tabular-nums">
                <span id="pc-compute" data-pc-value>{money(compute)}</span>
                <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable</span>
              </span>
            </div>
            <div class="flex items-baseline justify-between gap-3.5 py-[13px] border-t border-inkBorder">
              <span class="font-mono text-12 leading-[normal] text-termMuted">checkpoint storage</span>
              <span class="font-mono text-13 leading-[normal] text-parchment tabular-nums">
                <span id="pc-storage" data-pc-value>{money(storage)}</span>
                <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable</span>
              </span>
            </div>
            <div class="flex items-baseline justify-between gap-3.5 py-[13px] border-t border-inkBorder">
              <span class="font-mono text-12 leading-[normal] text-termMuted">managed tokens</span>
              <span class="font-mono text-13 leading-[normal] text-parchment tabular-nums">
                <span id="pc-tokens" data-pc-value>{money(tokens)}</span>
                <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable</span>
              </span>
            </div>
            <div class="flex items-baseline justify-between gap-3.5 py-[13px] border-t border-inkBorder">
              <span class="font-mono text-12 leading-[normal] text-blush">tokens not re-purchased</span>
              <span class="font-mono text-13 leading-[normal] text-blush tabular-nums">
                <span id="pc-saved" data-pc-value>&minus;{money(notRepurchased)}</span>
                <span data-pc-unavail class={unavailChip}><span class="w-[5px] h-[5px] bg-stone rotate-45 block"></span>unavailable</span>
              </span>
            </div>
          </div>
          <div class="border-t border-inkBorder mt-1.5 pt-[18px]">
            <p id="pc-savingline" class="text-13 leading-[1.6] text-borderMuted m-0">The last row is money you would otherwise have spent re-sending context. It is an estimate at list rates until we meter your real trace.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="max-w-[1180px] mx-auto px-7 pt-[76px]">
      <h2 class="font-serif text-[clamp(28px,3.6vw,40px)] leading-[1.1] tracking-[-0.02em] font-normal m-0 mb-[30px]">Questions with money in them.</h2>
      <div class="border-t border-sand">
        {faqs.map((f, i) => (
          <details name="pricing-faq" class="group border-b border-sand" open={i === 0}>
            <summary class="list-none cursor-pointer flex items-center justify-between gap-4 py-5 px-1 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-3 min-w-0">
                <span class="w-[6px] h-[6px] bg-sandDeep group-open:bg-claret rotate-45 block flex-none"></span>
                <span class="font-sans text-16 leading-[normal] font-medium text-ink">{f.q}</span>
              </span>
              <span class="font-mono text-14 leading-[normal] text-taupe flex-none"><span class="group-open:hidden">+</span><span class="hidden group-open:inline">&minus;</span></span>
            </summary>
            <p class="text-15 leading-[1.7] text-slate mt-0 mb-[22px] pl-[18px] max-w-[46em]">{f.a}</p>
          </details>
        ))}
      </div>
    </section>

    <!-- partner CTA -->
    <section id="partner" class="bg-ink mt-[84px]">
      <div class="max-w-[1180px] mx-auto px-7 py-[76px]">
        <div class="max-w-[44em]">
          <h2 class="font-serif text-[clamp(30px,4.2vw,46px)] leading-[1.08] tracking-[-0.02em] font-normal text-paper m-0 mb-[22px]">One real plug-pull, on us.</h2>
          <p class="text-17 leading-[1.7] text-borderMuted m-0 mb-[30px]">Free credits cover a full six-hour run and the kill that would have ended it. You will see the resume before you see an invoice.</p>
          <div class="flex gap-3.5 flex-wrap">
            <a href="#partner" class="text-15 leading-[normal] font-medium text-paper bg-claret py-[13px] px-[22px] rounded-3 no-underline hover:no-underline hover:text-paper">Start building</a>
            <a href="/enterprise" class="text-15 leading-[normal] font-medium text-paper border border-inkLine py-3 px-[21px] rounded-3 no-underline hover:no-underline hover:text-paper">Talk to us about Enterprise</a>
          </div>
          <p class="font-mono text-11 leading-[normal] tracking-[0.1em] text-termMuted mt-[30px] mb-0">keepstate.ai · the durable agent session cloud</p>
        </div>
      </div>
    </section>

    <style is:global>
      /* The composite helmet's control styles, tokens only. */
      input[type='range'] {
        -webkit-appearance: none;
        appearance: none;
        width: 100%;
        height: 3px;
        background: theme(colors.sand);
        border-radius: 2px;
        outline: none;
      }
      input[type='range']::-webkit-slider-thumb {
        -webkit-appearance: none;
        width: 15px;
        height: 15px;
        background: theme(colors.claret);
        transform: rotate(45deg);
        cursor: pointer;
        border: none;
      }
      input[type='range']::-moz-range-thumb {
        width: 13px;
        height: 13px;
        background: theme(colors.claret);
        border: none;
        cursor: pointer;
      }
      :focus-visible {
        outline: 2px solid theme(colors.claret);
        outline-offset: 2px;
        border-radius: 2px;
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { animation: none !important; transition: none !important; }
      }
    </style>

    <script is:inline>
      (function () {
        var $ = function (id) { return document.getElementById(id); };
        var byok = false;
        var money = function (n) { return '$' + n.toLocaleString('en-US', { maximumFractionDigits: 0 }); };
        // UI Law 1 for calculators: an invalid reading never renders 0 or
        // NaN; it flips every output to the unavailable chip.
        var read = function (el) {
          if (!el) return null;
          var n = Number(el.value), lo = Number(el.min), hi = Number(el.max);
          return Number.isFinite(n) && n >= lo && n <= hi ? n : null;
        };
        var setUnavailable = function (bad) {
          document.querySelectorAll('[data-pc-value]').forEach(function (el) { el.classList.toggle('hidden', bad); });
          document.querySelectorAll('[data-pc-unavail]').forEach(function (el) {
            el.classList.toggle('hidden', !bad);
            el.classList.toggle('inline-flex', bad);
          });
        };
        var render = function () {
          var a = read($('pc-agents')), h = read($('pc-hours')), c = read($('pc-cad'));
          $('pc-agents-val').textContent = a === null ? '?' : String(a);
          $('pc-hours-val').textContent = h === null ? '?' : String(h);
          $('pc-cad-val').textContent = c === null ? 'every ?' : 'every ' + c + 'm';
          if (a === null || h === null || c === null || c <= 0) { setUnavailable(true); return; }
          var days = 30, vmRate = 0.011, gbMonth = 0.09;
          var hoursMonth = a * h * days;
          var compute = hoursMonth * 60 * vmRate;
          var ckptsPerAgent = (h * 60 / c) * days;
          var gb = a * Math.max(1.2, (ckptsPerAgent * 0.041) / 19);
          var storage = gb * gbMonth;
          var tokens = byok ? 0 : hoursMonth * 1.9;
          var total = compute + storage + tokens;
          var saved = hoursMonth * 2.4;
          if (![hoursMonth, compute, storage, tokens, total, saved].every(Number.isFinite)) { setUnavailable(true); return; }
          setUnavailable(false);
          $('pc-total').textContent = money(total);
          $('pc-subtitle').textContent = hoursMonth.toLocaleString('en-US') + ' agent-hours per month';
          $('pc-compute').textContent = money(compute);
          $('pc-storage').textContent = money(storage);
          var t = $('pc-tokens');
          t.textContent = byok ? 'not metered' : money(tokens);
          t.classList.toggle('text-termMuted', byok);
          t.classList.toggle('text-parchment', !byok);
          $('pc-saved').textContent = '−' + money(saved);
          $('pc-keynote').textContent = byok
            ? 'You pay your provider directly. We meter durability only, and the token meter drops off this bill.'
            : 'We broker inference at a 4 percent spread, with cache-aware routing and stored-response replay included.';
          $('pc-savingline').textContent = byok
            ? 'With your own keys the saving lands on your provider invoice, not ours. The ledger still shows every token the store served instead of the model.'
            : 'The last row is money you would otherwise have spent re-sending context. It is an estimate at list rates until we meter your real trace.';
        };
        var setMode = function (v) {
          byok = v;
          var on = ['bg-ink', 'text-paper'], off = ['text-slate'];
          var managed = $('pc-managed'), byokBtn = $('pc-byok');
          [managed, byokBtn].forEach(function (btn, i) {
            var active = (i === 1) === v;
            on.forEach(function (cls) { btn.classList.toggle(cls, active); });
            off.forEach(function (cls) { btn.classList.toggle(cls, !active); });
          });
          render();
        };
        ['pc-agents', 'pc-hours', 'pc-cad'].forEach(function (id) {
          $(id).addEventListener('input', render);
        });
        $('pc-managed').addEventListener('click', function () { setMode(false); });
        $('pc-byok').addEventListener('click', function () { setMode(true); });
        render();
      })();
    </script>
    <Footer variant="marketing" />
  </body>
</html>
