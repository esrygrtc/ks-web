---
// A Ledger post, rebuilt 1:1 from design/The Ledger.dc.html (isPost
// branch): back button, tag-pill row, serif display title, the
// composite's block styles (sans body, serif crossheads, pull quotes,
// dark code blocks, note callouts), the gate-run footer, and the "next
// in the ledger" rail. Carve-outs (constitution): the composite's sample
// authors and invented gate ids are not shipped; the pill slot carries
// DRAFT for drafts, read time is computed from the real word count, and
// drafts also carry a top banner plus robots noindex until founder
// review. The rail renders only when other real posts exist.
import Site from '../../layouts/Site.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const entries = await getCollection('ledger');
  return entries.map((e) => ({
    params: { slug: e.id.replace(/\.mdx?$/, '') },
    props: { entry: e },
  }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const others = (await getCollection('ledger'))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => b.data.date.localeCompare(a.data.date))
  .slice(0, 2);
const read = `${Math.max(1, Math.round((entry.body ?? '').trim().split(/\s+/).length / 200))} min read`;
---
<Site
  title={`${entry.data.title} · The Ledger · KeepState`}
  description={entry.data.standfirst}
  noindex={entry.data.draft}
>
  <main class="w-full">
    {entry.data.draft && (
      <div class="bg-blushBg border-b border-shell">
        <p class="max-w-[760px] mx-auto px-7 py-3 font-mono text-11 tracking-[0.08em] uppercase text-claret m-0">DRAFT · awaiting founder review · not yet an official position</p>
      </div>
    )}

    <article class="max-w-[760px] mx-auto px-7 pt-10 pb-0">
      <a href="/ledger/" class="inline-block font-sans text-13 text-slate no-underline bg-transparent border border-sand rounded-3 px-3.5 py-2 mb-[34px] hover:text-ink">&larr; The Ledger</a>

      <div class="flex items-center gap-3 flex-wrap mb-[18px]">
        <span class="font-mono text-10 tracking-[0.1em] uppercase text-claret border border-shell bg-blushBg rounded-pill px-2.5 py-1">{entry.data.draft ? 'DRAFT' : entry.data.tag}</span>
        <span class="font-mono text-[11.5px] text-taupe">{entry.data.date} · {read}</span>
      </div>

      <h1 class="font-serif text-[clamp(32px,4.6vw,46px)] leading-[1.06] tracking-[-0.024em] font-normal mt-0 mb-10">{entry.data.title}</h1>

      <div class="ledger-prose">
        <Content />
      </div>

      <div class="border-t border-sand mt-10 pt-[26px] flex items-center justify-between gap-[18px] flex-wrap">
        <p class="text-14 leading-[1.65] text-slate m-0 max-w-[34em]">Every number here comes from a gate run. If one disagrees with your own measurement, that is a finding and we will publish the correction.</p>
        <a href="/proof" class="inline-flex items-center gap-[7px] font-mono text-12 text-claret no-underline whitespace-nowrap hover:text-ink">
          <span class="w-[5px] h-[5px] bg-claret rotate-45 inline-block"></span>the proof page
        </a>
      </div>
    </article>

    {others.length > 0 && (
      <section class="max-w-[760px] mx-auto px-7 pt-10 pb-[90px]">
        <p class="font-mono text-10 tracking-[0.12em] uppercase text-taupe mt-0 mb-4">next in the ledger</p>
        <div class="grid gap-0">
          {others.map((r) => (
            <a href={`/ledger/${r.id.replace(/\.mdx?$/, '')}/`} class="border-t border-sand py-[18px] px-0.5 no-underline flex items-baseline justify-between gap-[18px] flex-wrap">
              <span class="font-serif text-[19px] leading-[1.3] text-ink">{r.data.title}</span>
              <span class="font-mono text-[11.5px] text-taupe whitespace-nowrap">{r.data.date}</span>
            </a>
          ))}
        </div>
      </section>
    )}
    {others.length === 0 && <div class="pb-[90px]"></div>}
  </main>
</Site>

<style is:global>
  /* Block styles carried from the composite's post view. */
  .ledger-prose p { font-family: theme(fontFamily.sans); font-size: 17.5px; line-height: 1.78; color: theme(colors.slate); margin: 0 0 24px; text-wrap: pretty; }
  .ledger-prose h2 { font-family: theme(fontFamily.serif); font-size: 27px; line-height: 1.2; font-weight: 500; color: theme(colors.ink); margin: 38px 0 16px; }
  .ledger-prose h3 { font-family: theme(fontFamily.serif); font-size: theme(fontSize.20); line-height: 1.3; font-weight: 500; color: theme(colors.ink); margin: 30px 0 12px; }
  .ledger-prose a { color: theme(colors.claret); text-decoration: none; }
  .ledger-prose a:hover { color: theme(colors.ink); text-decoration: underline; text-underline-offset: 3px; }
  .ledger-prose strong { color: theme(colors.ink); }
  .ledger-prose blockquote { border-left: 2px solid theme(colors.shell); margin: 32px 0; padding: 2px 0 2px 22px; }
  .ledger-prose blockquote p { font-family: theme(fontFamily.serif); font-style: italic; font-size: 22px; line-height: 1.45; color: theme(colors.ink); margin: 0; }
  .ledger-prose ul, .ledger-prose ol { margin: 0 0 24px; padding-left: 22px; }
  .ledger-prose ul { list-style: disc outside; }
  .ledger-prose ol { list-style: decimal outside; }
  .ledger-prose li::marker { color: theme(colors.taupe); }
  .ledger-prose li { font-family: theme(fontFamily.sans); font-size: 17.5px; line-height: 1.7; color: theme(colors.slate); margin-bottom: 8px; }
  .ledger-prose code { font-family: theme(fontFamily.mono); font-size: theme(fontSize.13); background: theme(colors.parchment); border-radius: theme(borderRadius.2); padding: 1px 4px; }
  .ledger-prose pre { position: relative; background: theme(colors.ink); border-radius: theme(borderRadius.5); padding: 18px 20px; margin: 0 0 26px; overflow-x: auto; }
  .ledger-prose pre code { background: none; padding: 0; color: theme(colors.parchment); font-size: 12.5px; line-height: 1.8; }
  .ledger-prose table { width: 100%; border-collapse: collapse; font-size: theme(fontSize.13); margin: 0 0 26px; background: theme(colors.white); border: 1px solid theme(colors.sand); border-radius: theme(borderRadius.5); }
  .ledger-prose th { text-align: left; font-size: theme(fontSize.10); font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: theme(colors.taupe); padding: 11px 16px; border-bottom: 1px solid theme(colors.sand); background: theme(colors.paper); }
  .ledger-prose td { padding: 12px 16px; font-size: 13.5px; color: theme(colors.ink); border-bottom: 1px solid theme(colors.track); }
</style>
