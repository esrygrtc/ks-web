---
// The Ledger index, rebuilt 1:1 from design/The Ledger.dc.html (isIndex
// branch): masthead, tag-filter chips, the composite's list-row design,
// and the subscribe band, all at the composite's exact sizes. Carve-outs
// (constitution): the list holds exactly the real posts (one, DRAFT-
// marked); the composite's seven sample posts, their named authors, and
// the "18 posts · written by the 6 people" counts are fabrications and
// are NOT shipped. The post count is computed, read time is computed
// from the real word count, and drafts render a DRAFT eyebrow in the
// row's tag slot. The tag chips filter the real list (the composite's
// DCLogic behavior) and an empty filter renders an honest empty line.
// Subscribe posts to /api/subscribe, honeypot included.
import Site from '../../layouts/Site.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('ledger')).sort((a, b) =>
  b.data.date.localeCompare(a.data.date)
);
const slug = (id: string) => id.replace(/\.mdx?$/, '');
const read = (body: string | undefined) =>
  `${Math.max(1, Math.round((body ?? '').trim().split(/\s+/).length / 200))} min read`;
const tags = ['all', 'measurement', 'postmortem', 'argument', 'engineering'];
---
<Site
  title="The Ledger · KeepState"
  description="KeepState's engineering notebook: things we measured, things we got wrong, and the occasional argument about where agent infrastructure is going."
>
  <main class="w-full pb-[90px]">
    <section class="max-w-[1180px] mx-auto px-7 pt-[68px] pb-11">
      <div class="flex items-center gap-[9px] mb-5">
        <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>
        <span class="text-11 font-semibold tracking-[0.16em] uppercase text-claret">The Ledger</span>
      </div>
      {/* Composite says max-width 15em; our self-hosted Newsreader cut runs a
          touch narrower than the composite's hosted cut, so 14em reproduces
          the composite's line break ("...notebook we / happen to publish."). */}
      <h1 class="font-serif text-[clamp(38px,5.4vw,60px)] leading-[1.04] tracking-[-0.025em] font-normal mt-0 mb-6 max-w-[14em]">An engineering notebook we happen to publish.</h1>
      <p class="text-17 leading-[1.7] text-slate mt-0 mb-[22px] max-w-[44em] [text-wrap:pretty]">No thought leadership, no listicles, no reposted benchmarks. Things we measured, things we got wrong, and the occasional argument about where agent infrastructure is going. Every number in every post cites the gate that produced it.</p>
      <p class="font-mono text-12 leading-[1.7] text-taupe m-0">{posts.length} {posts.length === 1 ? 'post' : 'posts'} · written by the people who build it · no guest posts, ever</p>
    </section>

    <section class="max-w-[1180px] mx-auto px-7">
      <div class="flex items-center gap-2 flex-wrap mb-6">
        {tags.map((t) => (
          <button
            type="button"
            data-tag-chip={t}
            class={`font-mono text-11 tracking-[0.06em] rounded-pill px-[13px] py-1.5 cursor-pointer border ${
              t === 'all' ? 'bg-ink text-paper border-ink' : 'bg-white text-slate border-sand'
            }`}
          >{t === 'all' ? 'all posts' : t}</button>
        ))}
      </div>

      <div class="grid gap-0 border-t border-sand">
        {posts.map((p) => (
          <article class="border-b border-sand" data-post={p.data.tag ?? ''}>
            <a
              href={`/ledger/${slug(p.id)}/`}
              class="w-full no-underline px-0.5 py-6 grid [grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr))] gap-x-8 gap-y-3 items-start group"
            >
              <div class="min-w-0">
                <div class="flex items-center gap-2.5 flex-wrap mb-2.5">
                  <span class={`w-[6px] h-[6px] rotate-45 block shrink-0 ${p.data.draft ? 'bg-claret' : 'bg-stone'}`}></span>
                  <span class={`font-mono text-10 tracking-[0.08em] uppercase ${p.data.draft ? 'text-claret' : 'text-taupe'}`}>{p.data.draft ? 'draft' : p.data.tag}</span>
                </div>
                <h2 class="font-serif text-[23px] leading-[1.22] font-medium text-ink m-0 group-hover:underline [text-underline-offset:4px] decoration-1">{p.data.title}</h2>
              </div>
              <p class="text-[14.5px] leading-[1.65] text-slate m-0">{p.data.standfirst}</p>
              <p class="font-mono text-[11.5px] leading-[1.7] text-taupe m-0 text-right">{p.data.date}<br />{read(p.body)}</p>
            </a>
          </article>
        ))}
        <p data-empty hidden class="font-mono text-12 text-taupe border-b border-sand py-6 px-0.5 m-0">no posts under this tag yet · nothing is backfilled</p>
      </div>

      <div class="bg-parchment border border-sand rounded-5 px-6 py-[26px] mt-[34px] flex items-center justify-between gap-6 flex-wrap">
        <div class="min-w-0 max-w-[34em]">
          <p class="text-14 font-semibold mt-0 mb-2">The Session Economy</p>
          <p class="text-[13.5px] leading-[1.65] text-slate m-0">Five essays on where agent infrastructure is going. One email per essay. Nothing else.</p>
        </div>
        <form method="post" action="/api/subscribe" class="flex gap-2 flex-nowrap flex-[1_1_280px] min-w-0">
          <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input
            type="email" name="email" required placeholder="you@company.com" aria-label="email address"
            class="flex-[1_1_0%] min-w-0 font-sans text-13 text-ink bg-white border border-sand rounded-3 px-[13px] py-[11px] focus:outline-none focus:border-claret"
          />
          <button type="submit" class="font-sans text-13 font-medium text-paper bg-claret border-0 rounded-3 px-[17px] py-[11px] cursor-pointer hover:bg-claretDeep flex-none">Subscribe</button>
        </form>
      </div>
    </section>
  </main>
</Site>

<script is:inline>
  // Tag filtering, from the composite's DCLogic: chips filter the list;
  // an empty result renders the honest empty line rather than nothing.
  (function () {
    var chips = Array.prototype.slice.call(document.querySelectorAll('[data-tag-chip]'));
    var rows = Array.prototype.slice.call(document.querySelectorAll('[data-post]'));
    var empty = document.querySelector('[data-empty]');
    var on = ['bg-ink', 'text-paper', 'border-ink'];
    var off = ['bg-white', 'text-slate', 'border-sand'];
    chips.forEach(function (c) {
      c.addEventListener('click', function () {
        chips.forEach(function (x) {
          x.classList.remove.apply(x.classList, on);
          x.classList.add.apply(x.classList, off);
        });
        c.classList.remove.apply(c.classList, off);
        c.classList.add.apply(c.classList, on);
        var t = c.getAttribute('data-tag-chip');
        var shown = 0;
        rows.forEach(function (r) {
          var show = t === 'all' || r.getAttribute('data-post') === t;
          r.hidden = !show;
          if (show) shown++;
        });
        if (empty) empty.hidden = shown > 0;
      });
    });
  })();
</script>
