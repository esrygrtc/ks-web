---
// The global footer: a checkpoint on the border, a law in the middle, a
// status line at the bottom. Three densities: marketing (five bands),
// docs (bands 3-5), console (band 5 only; no marketing inside the app).
// UI Law 3 lives here: with no live feed, every status field prints
// unavailable, and the dot is never green because nothing said otherwise.
import StatusChip from './StatusChip.astro';
import Terminal from './Terminal.astro';
interface Props { variant?: 'marketing' | 'docs' | 'console' }
const { variant = 'marketing' } = Astro.props;

// Only links whose pages exist ship; the rest land with their phases
// (W3 docs/ledger/legal, W4 support). Progressive honesty over 404s.
const columns = [
  { head: 'Product', links: [
    ['Sessions', '/product/sessions'], ['Fork', '/product/fork'],
    ['Gateway & Cost', '/product/gateway-cost'], ['Governance & Replay', '/product/governance-replay'],
    ['Pricing', '/pricing'], ['Compatibility', '/compatibility'] ] },
  { head: 'Developers', links: [ ['Proof', '/proof'], ['Status', '/status'] ] },
  { head: 'Company', links: [
    ['Manifesto', '/manifesto'], ['About', '/about'], ['Customers', '/customers'],
    ['Enterprise', '/enterprise'], ['Careers', '/careers'], ['Press', '/press'] ] },
  { head: 'Programs & Trust', links: [
    ['Grants', '/grants'], ['Security', '/security'], ['Contact', '/contact'] ] },
];
const epigraphs = [
  "Hosts sleep; ledgers don't.",
  'Assert the fact, not the residue.',
  'What gates watch stays true; what nothing watches drifts.',
  'No claim outlives its gate.',
  'The gateway can hold the door open forever; walking back through it belongs to the client.',
];
// Deterministic per-build rotation: the day picks the law.
const epigraph = epigraphs[new Date().getUTCDate() % epigraphs.length];
const systemLine = 'keepstate v0.1.1 · api unavailable · gateway unavailable · doctor unavailable · incidents unavailable · westeurope';
const legal = ['Terms', 'Privacy', 'DPA', 'Subprocessors', 'Acceptable Use'];
---
<footer class="border-t border-sand bg-paper mt-16">
  {variant === 'marketing' && (
    <>
      <div class="max-w-[1180px] mx-auto px-7 pt-10 pb-8 border-b border-parchment">
        <p class="inline-flex items-center gap-2 font-mono text-10 uppercase tracking-[0.12em] text-claret m-0 mb-3">
          <span class="w-[7px] h-[7px] bg-claret rotate-45 block"></span>checkpoint reached
        </p>
        <div class="flex items-end justify-between gap-8 flex-wrap">
          <p class="font-serif text-26 text-ink m-0">The durable agent session cloud.</p>
          <div class="w-full max-w-md">
            <p class="font-mono text-10 uppercase tracking-[0.1em] text-taupe m-0 mb-2">install</p>
            <Terminal copy="curl -fsSL keepstate.ai/install | sh">$ curl -fsSL keepstate.ai/install | sh</Terminal>
          </div>
        </div>
      </div>
      <div class="max-w-[1180px] mx-auto px-7 py-7 border-b border-parchment">
        <div class="flex items-center justify-between gap-8 flex-wrap">
          <div>
            <p class="font-serif text-17 text-ink m-0 mb-1">The Session Economy</p>
            <p class="text-13 text-slate m-0">Five essays on where agent infrastructure is going. One email per essay. Nothing else.</p>
          </div>
          <form class="flex gap-2" data-subscribe method="post" action="/api/subscribe">
            <input type="email" name="email" required placeholder="you@company.com" aria-label="email address"
              class="font-sans text-14 text-ink bg-white border border-sand rounded-3 px-3 py-2.5 w-64 focus:outline-none focus:border-ink" />
            <button type="submit" class="font-sans text-14 font-medium text-paper bg-claret border border-claret rounded-3 px-[18px] py-2.5 cursor-pointer hover:bg-claretDeep">Subscribe</button>
          </form>
        </div>
      </div>
    </>
  )}
  {variant !== 'console' && (
    <>
      <div class="max-w-[1180px] mx-auto px-7 py-8 grid grid-cols-2 md:grid-cols-4 gap-8 border-b border-parchment">
        {columns.map((c) => (
          <div>
            <p class="font-mono text-10 uppercase tracking-[0.12em] text-taupe m-0 mb-3">{c.head}</p>
            <ul class="list-none m-0 p-0 grid gap-1.5">
              {c.links.map(([label, href]) => (
                <li><a href={href} class="text-13 text-slate no-underline hover:text-ink hover:underline underline-offset-2 py-1 inline-block">{label}</a></li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="max-w-[1180px] mx-auto px-7 py-5 border-b border-parchment">
        <p class="font-serif italic text-15 text-taupe m-0">{epigraph}</p>
      </div>
    </>
  )}
  <div class="max-w-[1180px] mx-auto px-7 py-4 flex items-center justify-between gap-4 flex-wrap">
    <div class="flex items-center gap-3.5 flex-wrap">
      <StatusChip />
      <p class="font-mono text-11 text-taupe m-0" data-system-line>{systemLine}</p>
    </div>
    <div class="flex items-center gap-3.5 flex-wrap">
      {variant !== 'console' && legal.map((l) => (
        <span class="font-mono text-12 text-stone" title="arrives with the docs phase">{l}</span>
      ))}
      <p class="font-mono text-12 text-termMuted m-0">© 2026 KeepState, Inc. · Every claim on this site cites its evidence: <a href="/proof" class="text-blush no-underline hover:underline">/proof</a></p>
    </div>
  </div>
</footer>
