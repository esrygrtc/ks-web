---
// UI Law 2: every rendered number carries provenance. This is the mark.
interface Props { kind: 'MEASURED' | 'ESTIMATED'; onDark?: boolean }
const { kind, onDark = false } = Astro.props;
if (kind !== 'MEASURED' && kind !== 'ESTIMATED')
  throw new Error(`Badge: kind must be MEASURED or ESTIMATED, got "${kind}"`);
// onDark: WCAG AA on ink backgrounds (the light palette measures 3.4:1 there)
const cls = onDark
  ? (kind === 'MEASURED' ? 'text-paper border-paper' : 'text-parchment border-borderMuted')
  : (kind === 'MEASURED' ? 'text-ink border-ink' : 'text-taupe border-sandDeep');
---
<span class={`font-mono text-9 tracking-[0.12em] border rounded-2 px-1.5 py-0.5 ${cls}`}>{kind}</span>
