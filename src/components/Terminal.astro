---
// The terminal block. No traffic lights; a claret diamond marks the live
// session. Copy button copies the data-copy payload, or the commands slot.
interface Props { session?: string; copy?: string }
const { session, copy } = Astro.props;
---
<div class="bg-ink border border-inkBorder rounded-5 p-[16px_18px] relative" data-terminal>
  <div class="flex items-center justify-between mb-2.5">
    <span class="font-mono text-10 uppercase tracking-[0.1em] text-termMuted">{session ?? 'terminal'}</span>
    <span class="flex items-center gap-2.5">
      {copy && (
        <button type="button" data-copy={copy}
          class="font-mono text-10 text-termMuted bg-ink border border-inkSoft rounded-2 px-1.5 py-0.5 cursor-pointer hover:text-parchment">
          copy
        </button>
      )}
      <span class="w-[6px] h-[6px] bg-claret rotate-45 block"></span>
    </span>
  </div>
  <div class="font-mono text-12 leading-[1.65] text-parchment whitespace-pre-wrap"><slot /></div>
</div>
<script>
  document.querySelectorAll('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.getAttribute('data-copy') ?? '');
      const old = b.textContent; b.textContent = 'copied';
      setTimeout(() => (b.textContent = old), 1200);
    });
  });
</script>
