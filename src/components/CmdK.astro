---
// Command palette shell. Opens on cmd-K / ctrl-K; search wires to
// Pagefind at W3. Until then it is honest about being a shell.
---
<button type="button" data-cmdk-open
  class="w-full max-w-[460px] flex items-center justify-between gap-3 font-sans text-13 text-taupe bg-white border border-sand rounded-3 px-[13px] py-[9px] cursor-pointer hover:border-ink text-left">
  <span>Search the docs</span>
  <span class="font-mono text-10 border border-sand rounded-2 px-1.5 py-px">&#8984;K</span>
</button>
<div data-cmdk-overlay class="hidden fixed inset-0 bg-ink/40 items-start justify-center pt-[12vh] px-5 pb-5 z-[100]">
  <div class="w-full max-w-[560px] bg-paper border border-sand rounded-6 shadow-e3 overflow-hidden">
    <div class="flex items-center gap-3 px-[18px] py-[15px] border-b border-sand">
      <span class="w-[7px] h-[7px] bg-claret rotate-45 block shrink-0"></span>
      <input type="text" data-cmdk-input placeholder="Search the docs" autocomplete="off"
        class="flex-1 min-w-0 font-sans text-15 text-ink bg-[transparent] border-0 focus:outline-none" />
      <span class="font-mono text-10 text-taupe border border-sand rounded-3 px-1.5 py-0.5">esc</span>
    </div>
    <div data-cmdk-results class="max-h-[340px] overflow-y-auto p-2"></div>
  </div>
</div>
<style is:global>
  /* Pagefind excerpts arrive with <mark>; the browser default yellow is
     off-palette, so highlights carry the design's blush treatment. */
  [data-cmdk-results] mark { background: theme(colors.blushBg); color: theme(colors.claret); }
</style>
<script>
  const overlay = document.querySelector('[data-cmdk-overlay]');
  let pagefind = null;
  const ensureIndex = async () => {
    if (pagefind) return pagefind;
    // /pagefind/pagefind.js exists only in the built site (pagefind runs
    // after astro build), so the bundler must not try to resolve it; the
    // indirection keeps the import a runtime-only URL.
    const pagefindUrl = '/pagefind/pagefind.js';
    try { pagefind = await import(/* @vite-ignore */ pagefindUrl); await pagefind.init(); } catch { pagefind = null; }
    return pagefind;
  };
  const resultsEl = () => overlay?.querySelector('[data-cmdk-results]');
  let seq = 0;
  document.querySelector('[data-cmdk-input]')?.addEventListener('input', async (e) => {
    const q = e.target.value.trim();
    const el = resultsEl(); if (!el) return;
    const my = ++seq;
    if (!q) { el.innerHTML = ''; return; }
    const pf = await ensureIndex();
    if (!pf) { el.innerHTML = '<p class="font-mono text-11 text-taupe px-3 py-2 m-0">search unavailable (index not built)</p>'; return; }
    const search = await pf.search(q);
    if (my !== seq) return;
    const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
    el.innerHTML = items.length
      ? items.map((d) => `<a href="${d.url}" class="block px-3 py-[11px] rounded-4 no-underline hover:bg-parchment">
          <span class="block text-14 text-ink">${d.meta?.title ?? d.url}</span>
          <span class="block text-12 text-taupe">${d.excerpt}</span></a>`).join('')
      : '<p class="font-mono text-11 text-taupe px-3 py-2 m-0">nothing found</p>';
  });
  const show = (on) => { overlay?.classList.toggle('hidden', !on); overlay?.classList.toggle('flex', on);
    if (on) overlay?.querySelector('[data-cmdk-input]')?.focus(); };
  document.querySelector('[data-cmdk-open]')?.addEventListener('click', () => show(true));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); show(true); }
    if (e.key === 'Escape') show(false);
  });
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) show(false); });
</script>
