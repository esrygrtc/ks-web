---
// Command palette shell. Opens on cmd-K / ctrl-K; search wires to
// Pagefind at W3. Until then it is honest about being a shell.
---
<button type="button" data-cmdk-open
  class="inline-flex items-center gap-2.5 font-sans text-13 text-taupe bg-white border border-sand rounded-3 px-3 py-2 cursor-pointer hover:border-ink w-64 justify-between">
  <span>Search sessions, checkpoints, docs</span>
  <span class="font-mono text-11 text-stone border border-sand rounded-2 px-1.5 py-0.5">&#8984;K</span>
</button>
<div data-cmdk-overlay class="hidden fixed inset-0 bg-ink/40 items-start justify-center pt-[18vh] z-50">
  <div class="bg-white border border-sand rounded-5 shadow-e2 w-[560px] max-w-[90vw] p-2">
    <input type="text" data-cmdk-input placeholder="Type to search" autocomplete="off"
      class="w-full font-sans text-14 text-ink px-3 py-2.5 border-0 focus:outline-none" />
    <div data-cmdk-results class="max-h-[320px] overflow-y-auto border-t border-parchment"></div>
    <p class="font-mono text-11 text-taupe px-3 py-2 border-t border-parchment m-0">
      static index, built at compile time; esc closes
    </p>
  </div>
</div>
<script>
  const overlay = document.querySelector('[data-cmdk-overlay]');
  let pagefind = null;
  const ensureIndex = async () => {
    if (pagefind) return pagefind;
    try { pagefind = await import('/pagefind/pagefind.js'); await pagefind.init(); } catch { pagefind = null; }
    return pagefind;
  };
  const resultsEl = () => overlay?.querySelector('[data-cmdk-results]');
  let seq = 0;
  document.querySelector('[data-cmdk-input]')?.addEventListener('input', async (e) => {
    const q = e.target.value.trim();
    const el = resultsEl(); if (!el) return;
    const my = ++seq;
    if (!q) { el.innerHTML = ''; return; }
    const pf = await ensureIndex();
    if (!pf) { el.innerHTML = '<p class="font-mono text-11 text-taupe px-3 py-2 m-0">search unavailable (index not built)</p>'; return; }
    const search = await pf.search(q);
    if (my !== seq) return;
    const items = await Promise.all(search.results.slice(0, 8).map((r) => r.data()));
    el.innerHTML = items.length
      ? items.map((d) => `<a href="${d.url}" class="block px-3 py-2 no-underline hover:bg-parchment">
          <span class="block text-13 text-ink font-medium">${d.meta?.title ?? d.url}</span>
          <span class="block text-12 text-taupe">${d.excerpt}</span></a>`).join('')
      : '<p class="font-mono text-11 text-taupe px-3 py-2 m-0">nothing found</p>';
  });
  const show = (on) => { overlay?.classList.toggle('hidden', !on); overlay?.classList.toggle('flex', on);
    if (on) overlay?.querySelector('[data-cmdk-input]')?.focus(); };
  document.querySelector('[data-cmdk-open]')?.addEventListener('click', () => show(true));
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); show(true); }
    if (e.key === 'Escape') show(false);
  });
  overlay?.addEventListener('click', (e) => { if (e.target === overlay) show(false); });
</script>
