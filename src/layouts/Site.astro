---
import '../styles/fonts.css';
import Footer from '../components/Footer.astro';
import CmdK from '../components/CmdK.astro';
interface Pager { prev?: { title: string; href: string }; next?: { title: string; href: string } }
interface Props { title: string; description: string; footer?: 'marketing' | 'docs' | 'console'; header?: 'marketing' | 'docs'; noindex?: boolean; pager?: Pager }
const { title, description, footer = 'marketing', header = 'marketing', noindex = false, pager } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/Newsreader-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Inter-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/JetBrainsMono-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body class="bg-paper text-ink font-sans min-h-screen flex flex-col">
    {header === 'docs' ? (
      <header class="sticky top-0 z-50 bg-paper/95 backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
        <div class="px-6 py-[13px] flex items-center justify-between gap-[18px] flex-wrap">
          <div class="flex items-center gap-3">
            <a href="/" class="flex items-center gap-[9px] text-ink no-underline">
              <span class="w-2 h-2 bg-claret rotate-45 block"></span>
              <span class="font-serif text-[19px] font-medium">KeepState</span>
            </a>
            <a href="/docs/" class="font-mono text-11 tracking-[0.1em] text-taupe border-l border-sand pl-3 no-underline hover:text-ink">docs</a>
          </div>
          <div class="flex items-center gap-3 flex-[1_1_260px] max-w-[460px] min-w-0">
            <CmdK />
          </div>
          <div class="flex items-center gap-[18px] flex-wrap">
            <a href="/pricing" class="text-13 text-slate no-underline hover:text-ink">Pricing</a>
            <a href="/proof" class="text-13 text-slate no-underline hover:text-ink">Proof</a>
            <a href="/console" class="text-13 font-medium text-claret no-underline hover:text-claretDeep">Console →</a>
          </div>
        </div>
      </header>
    ) : (
    <header class="sticky top-0 z-50 bg-paper/[0.94] backdrop-blur-[6px] backdrop-saturate-[1.4] border-b border-sand">
      <nav class="max-w-[1180px] mx-auto px-7 py-[15px] flex items-center justify-between gap-6 flex-wrap">
        <a href="/" class="flex items-center gap-2.5 text-ink no-underline">
          <span class="w-[9px] h-[9px] bg-claret rotate-45 block"></span>
          <span class="font-serif text-20 font-medium">KeepState</span>
        </a>
        <div class="flex items-center gap-6 flex-wrap">
          <a href="/product/sessions" class="text-14 text-slate no-underline hover:text-ink">Product</a>
          <a href="/#why-now" class="text-14 text-slate no-underline hover:text-ink">Why now</a>
          <a href="/manifesto" class="text-14 text-slate no-underline hover:text-ink">Manifesto</a>
          <a href="/docs" class="text-14 text-slate no-underline hover:text-ink">Docs</a>
          <a href="/pricing" class="text-14 text-slate no-underline hover:text-ink">Pricing</a>
          <a href="/proof" class="text-14 text-slate no-underline hover:text-ink">Proof</a>
          <a href="/#partner" class="text-14 font-medium text-paper bg-claret rounded-3 px-4 py-2 no-underline hover:bg-claretDeep">Start building</a>
        </div>
      </nav>
    </header>
    )}
    <div class="flex-1"><slot /></div>
    <Footer variant={footer} pager={pager} />
    <style is:global>
      /* The hidden attribute must beat display utilities (flex/grid),
         or every scripted state renders at once. */
      [hidden] { display: none !important; }
    </style>
  </body>
</html>
